---
import Monogram from './Monogram.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact } from '../data/contact';
import { anchor, nav, sectionIds } from '../data/navigation';
import { externalLink } from '../lib/links';
import { messages, waLink } from '../lib/whatsapp';
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href={anchor(sectionIds.top)}>
      <Monogram class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">Diogo Menani</span>{' '}
        <span class="brand-sub">Advocacia &amp; Assessoria Jurídica</span>
      </span>
    </a>
    <nav class="nav" aria-label="Principal" data-nav>
      {nav.map((item) => (
        <a href={anchor(item.id)}>{item.label}</a>
      ))}
      <span class="nav-ind" aria-hidden="true" data-nav-ind></span>
    </nav>
    <a class="btn btn-header" href={waLink(messages.default)} {...externalLink()}>
      Agendar conversa
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      <span data-menu-text>Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </div>
  <span class="progress" aria-hidden="true" data-progress></span>
</header>

<nav class="menu" id="menu" aria-label="Menu" data-menu inert>
  <div class="wrap menu-inner">
    <div class="menu-nav">
      {nav.map((item, i) => (
        <a href={anchor(item.id)} style={`--i:${i}`}>
          {item.label}
        </a>
      ))}
    </div>
    <div class="menu-foot">
      <WhatsAppButton label="Agendar uma conversa" />
      <p>
        {contact.oab} · {contact.serviceMode}
      </p>
    </div>
  </div>
</nav>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: #fff;
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      transform 0.7s var(--ease);
    animation: drop 1s var(--ease) 0.15s backwards;
  }

  .site-header.is-scrolled {
    background: rgb(255 255 255 / 97%);
    color: var(--royal);
    box-shadow:
      0 1px 0 var(--line),
      0 16px 36px -28px rgb(var(--royal-rgb) / 45%);
  }

  .site-header.is-tucked {
    transform: translate3d(0, -102%, 0);
  }

  /* Altura mínima, não fixa: com o texto ampliado (zoom só do texto), o header cresce. */
  .header-inner {
    display: flex;
    align-items: center;
    gap: 36px;
    min-height: var(--header-h);
    transition: min-height 0.5s var(--ease);
  }

  .site-header.is-scrolled .header-inner {
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-right: auto;
    min-height: 44px;
  }

  .brand-mark {
    width: 44px;
    height: auto;
    transition: transform 0.7s var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .brand:hover .brand-mark {
      transform: translateY(-1px) scale(1.05);
    }
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .brand-sub {
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 0.01em;
    opacity: 0.8;
  }

  .nav {
    position: relative;
    display: none;
    align-items: center;
    gap: 30px;
    font-size: 15px;
    font-weight: 500;
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    opacity: 0.82;
    transition: opacity 0.3s;
  }

  .nav a.is-active {
    opacity: 1;
  }

  @media (hover: hover) {
    .nav a:hover {
      opacity: 1;
    }
  }

  /* Indicador do link ativo: 1px de largura, esticado pelo script até a largura do link. */
  .nav-ind {
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 1px;
    height: 1.5px;
    background: currentColor;
    transform-origin: left center;
    opacity: 0;
    transition:
      transform 0.7s var(--ease),
      opacity 0.4s;
  }

  /* .btn.btn-header: vence o .btn da camada global pela especificidade, não pela ordem. */
  .btn.btn-header {
    display: none;
    min-height: 44px;
    padding: 0 20px;
    font-size: 15px;
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 55%);
  }

  .btn-header::before {
    background: #fff;
  }

  @media (hover: hover) {
    .btn-header:hover {
      color: var(--royal);
    }
  }

  .site-header.is-scrolled .btn-header {
    background: var(--royal);
    color: #fff;
    box-shadow: none;
  }

  .site-header.is-scrolled .btn-header::before {
    background: var(--royal-bright);
  }

  @media (hover: hover) {
    .site-header.is-scrolled .btn-header:hover {
      color: #fff;
    }
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 4px 0 10px;
    border: 0;
    background: none;
    color: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  .menu-icon {
    position: relative;
    width: 22px;
    height: 12px;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.6s var(--ease);
  }

  .menu-icon::before {
    top: 0;
  }

  .menu-icon::after {
    top: 10.5px;
  }

  :global(.page.is-menu-open) .menu-icon::before {
    transform: translateY(5.25px) rotate(45deg);
  }

  :global(.page.is-menu-open) .menu-icon::after {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* Aberto, o header fica royal opaco: os links do menu rolado passam por baixo da marca. */
  :global(.page.is-menu-open) .site-header {
    color: #fff;
    background: var(--royal);
    box-shadow: none;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--royal-bright);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .site-header.is-scrolled .progress {
    opacity: 1;
  }

  /* 1080 px: o mesmo ponto do DESKTOP_QUERY em src/scripts/menu.ts. */
  @media (width >= 1080px) {
    .nav {
      display: flex;
    }

    .btn.btn-header {
      display: inline-flex;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (1080px <= width <= 1199px) {
    .brand-sub {
      display: none;
    }

    .header-inner {
      gap: 28px;
    }

    .nav {
      gap: 24px;
    }
  }

  @media (width <= 479px) {
    .brand-sub {
      display: none;
    }
  }

  /* Menu mobile: tela cheia, revelado de cima para baixo. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + 28px) 0 32px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--sky-dim) transparent;
    scrollbar-width: thin;
    background: var(--royal);
    color: #fff;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.8s var(--ease),
      visibility 0s linear 0.8s;
  }

  :global(.page.is-menu-open) .menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.8s var(--ease),
      visibility 0s;
  }

  /*
   * Em tela baixa o menu rola, e o Firefox foca a área rolável pelo Tab: contorno branco e por
   * dentro, porque o menu ocupa a tela toda.
   */
  :global(.page) .menu:focus-visible {
    outline-color: #fff;
    outline-offset: -5px;
  }

  :global(.page.is-menu-open) .progress {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
  }

  .menu-nav a {
    display: block;
    padding: 8px 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 9vw, 54px);
    line-height: 1.15;
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    transition:
      opacity 0.5s ease,
      transform 0.8s var(--ease);
  }

  /* Ao abrir, os links entram um a um (--i é o índice de cada link). */
  :global(.page.is-menu-open) .menu-nav a {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.16s + var(--i) * 0.06s);
  }

  .menu-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin-top: auto;
    padding-top: 32px;
    border-top: 1px solid var(--line-on-royal);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  :global(.page.is-menu-open) .menu-foot {
    opacity: 1;
    transition-delay: 0.45s;
  }

  .menu-foot p {
    font-size: 14px;
    color: var(--sky);
  }

  /* Telas baixas (celular deitado): depois das regras base, para valer de fato. */
  @media (height <= 560px) {
    .menu {
      padding-top: var(--header-h);
    }

    .menu-nav a {
      font-size: 30px;
      padding: 4px 0;
    }

    .menu-foot {
      padding-top: 20px;
    }
  }

  /* Acima do DESKTOP_QUERY (src/scripts/menu.ts), o menu mobile não existe. */
  @media (width >= 1080px) {
    .menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Recolhe e volta sem deslizar. */
    .site-header {
      animation: fade 0.5s ease-out backwards !important;
      transition-property: background-color, color, box-shadow;
    }

    .menu,
    .menu-nav a {
      transition-duration: 0.2s !important;
    }

    .menu-nav a {
      transform: none !important;
    }

    /* O indicador troca de link sem deslizar. */
    .nav-ind {
      transition: opacity 0.4s;
    }

    /* As barras viram X sem girar, e o header muda de altura sem animar. */
    .menu-icon::before,
    .menu-icon::after,
    .header-inner {
      transition: none;
    }
  }

  /*
   * Alto contraste: as barras do menu e o indicador do link ativo são fundos, que o modo trocaria
   * pela cor da tela; ficam com a cor de sistema do texto.
   */
  @media (forced-colors: active) {
    .menu-icon::before,
    .menu-icon::after {
      forced-color-adjust: none;
      background: ButtonText;
    }

    .nav-ind {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  @media print {
    .site-header,
    .menu {
      display: none !important;
    }
  }
</style>
