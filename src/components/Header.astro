---
import Monogram from './Monogram.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact } from '../data/contact';
import { anchor, nav, sectionIds } from '../data/navigation';
import { EXTERNAL_LINK } from '../lib/links';
import { messages, waLink } from '../lib/whatsapp';
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href={anchor(sectionIds.top)} aria-label="Diogo Menani, voltar ao início">
      <Monogram class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">Diogo Menani</span>
        <span class="brand-sub">Advocacia &amp; Assessoria Jurídica</span>
      </span>
    </a>
    <nav class="nav" aria-label="Principal" data-nav>
      {nav.map((item) => (
        <a href={anchor(item.id)}>{item.label}</a>
      ))}
      <span class="nav-ind" aria-hidden="true" data-nav-ind></span>
    </nav>
    <a class="btn btn-header" href={waLink(messages.default)} {...EXTERNAL_LINK}>
      Agendar conversa
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Abrir menu"
      data-menu-toggle
    >
      <span data-menu-text>Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </div>
  <span class="progress" aria-hidden="true" data-progress></span>
</header>

<div class="menu" id="menu" aria-hidden="true" data-menu>
  <div class="wrap menu-inner">
    <nav class="menu-nav" aria-label="Menu">
      {nav.map((item) => (
        <a href={anchor(item.id)}>{item.label}</a>
      ))}
    </nav>
    <div class="menu-foot">
      <WhatsAppButton label="Agendar uma conversa" />
      <p>
        {contact.oab} · {contact.serviceMode}
      </p>
    </div>
  </div>
</div>
