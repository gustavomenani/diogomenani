---
import MobileMenu from './MobileMenu.astro';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { anchor, nav, sectionIds } from '../data/navigation';
import { messages, waLink } from '../lib/whatsapp';
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    {/*
      As duas versões do logo no mesmo lugar: a branca sobre o hero e o menu aberto, a azul com o
      header claro. Só uma tem texto alternativo, então o nome do link não muda com a rolagem.
    */}
    <a class="brand" href={anchor(sectionIds.top)}>
      <Logo
        class="brand-logo on-dark"
        tone="white"
        alt="Diogo Menani — Advocacia e Assessoria Jurídica"
        compact
      />
      <Logo class="brand-logo on-light" tone="blue" alt="" compact />
    </a>
    <nav class="nav" aria-label="Principal" data-nav>
      {nav.map((item) => (
        <a href={anchor(item.id)}>{item.label}</a>
      ))}
      <span class="nav-ind" aria-hidden="true" data-nav-ind></span>
    </nav>
    {/* O leitor de tela ouve que o link leva ao WhatsApp: este botão nem tem o ícone. */}
    <ExternalLink class="btn btn-caps btn-header" href={waLink(messages.default)}>
      Fale com um especialista<span class="sr-only">{' pelo WhatsApp'}</span>
      <Icon name="arrow-right" />
    </ExternalLink>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      {/*
        O rótulo reserva a largura de "Fechar" (a cópia invisível): ao abrir o menu, o botão não
        cresce, e o logo, que é o item flexível até 479 px, não encolhe.
      */}
      <span class="menu-text">
        <span data-menu-text>Menu</span>
        <span class="menu-text-ghost" aria-hidden="true">
          Fechar
        </span>
      </span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </div>
  <span class="progress" aria-hidden="true" data-progress></span>
</header>
<MobileMenu />

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: #fff;
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      transform 0.7s var(--ease);
  }

  /*
   * Entrada: só até ela terminar (data-entered, em main.ts). Depois, trocar a preferência de
   * movimento não a reinicia: mudar o animation-name criaria uma animação nova.
   */
  :global(.page:not([data-entered])) .site-header {
    animation: drop 1s var(--ease) 0.15s backwards;
  }

  .site-header.is-scrolled {
    background: rgb(255 255 255 / 97%);
    color: var(--royal);
    box-shadow:
      0 1px 0 var(--line),
      0 16px 36px -28px rgb(var(--royal-rgb) / 45%);
  }

  .site-header.is-tucked {
    transform: translate3d(0, -102%, 0);
  }

  /* Altura mínima, não fixa: com o texto ampliado (zoom só do texto), o header cresce. */
  .header-inner {
    display: flex;
    align-items: center;
    gap: 36px;
    min-height: var(--header-h);
    transition: min-height 0.5s var(--ease);
  }

  .site-header.is-scrolled .header-inner {
    min-height: var(--header-h-scrolled);
  }

  /* O logo tem altura fixa; a largura sai da proporção do arquivo (atributos width e height). */
  .brand {
    position: relative;
    display: flex;
    align-items: center;
    margin-right: auto;
    min-height: 44px;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 52px;
    transition: opacity 0.5s var(--ease);
  }

  /* A versão azul fica por cima da branca e aparece quando o header fica claro. */
  .brand-logo.on-light {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    opacity: 0;
  }

  .site-header.is-scrolled .brand-logo.on-light {
    opacity: 1;
  }

  .site-header.is-scrolled .brand-logo.on-dark {
    opacity: 0;
  }

  .nav {
    position: relative;
    display: none;
    align-items: center;
    gap: 30px;
    font-size: var(--fs-md);
    font-weight: 500;
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    opacity: 0.82;
    transition: opacity 0.3s;
  }

  .nav a.is-active {
    opacity: 1;
  }

  @media (hover: hover) {
    .nav a:hover {
      opacity: 1;
    }
  }

  /* Indicador do link ativo: 1px de largura, esticado pelo script até a largura do link. */
  .nav-ind {
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 1px;
    height: 1.5px;
    background: currentColor;
    transform-origin: left center;
    opacity: 0;
    transition:
      transform 0.7s var(--ease),
      opacity 0.4s;
  }

  /*
   * .btn.btn-header: vence o .btn da camada global pela especificidade, não pela ordem. Não
   * encolhe: o overflow: hidden do .btn zera o min-width automático do item flex, e sem isto o
   * botão encolheria abaixo do rótulo e cortaria o texto em silêncio.
   */
  .btn.btn-header {
    display: none;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 20px;
    white-space: nowrap;
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 55%);
  }

  /*
   * O preenchimento troca de cor junto com o rótulo (o color 0.4s do .btn) quando o header muda de
   * estado com o mouse em cima: trocado de estalo, ficava um instante branco sobre branco ou azul
   * sobre azul. .btn.btn-header, para vencer o .btn::before de buttons.css pela especificidade.
   */
  .btn.btn-header::before {
    background: #fff;
    transition:
      transform 0.7s var(--ease),
      background-color 0.4s var(--ease);
  }

  @media (hover: hover) {
    .btn-header:hover {
      color: var(--royal);
    }
  }

  .site-header.is-scrolled .btn-header {
    background: var(--royal);
    color: #fff;
    box-shadow: none;
  }

  .site-header.is-scrolled .btn-header::before {
    background: var(--royal-bright);
  }

  @media (hover: hover) {
    .site-header.is-scrolled .btn-header:hover {
      color: #fff;
    }
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 4px 0 10px;
    border: 0;
    background: none;
    color: inherit;
    font-weight: 600;
    font-size: var(--fs-md);
    cursor: pointer;
  }

  .menu-text {
    display: inline-grid;
    justify-items: end;
  }

  .menu-text > * {
    grid-area: 1 / 1;
  }

  .menu-text-ghost {
    visibility: hidden;
  }

  .menu-icon {
    position: relative;
    width: 22px;
    height: 12px;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.6s var(--ease);
  }

  .menu-icon::before {
    top: 0;
  }

  .menu-icon::after {
    top: 10.5px;
  }

  :global(.page.is-menu-open) .menu-icon::before {
    transform: translateY(5.25px) rotate(45deg);
  }

  :global(.page.is-menu-open) .menu-icon::after {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* Aberto, o header fica royal opaco: os links do menu rolado passam por baixo da marca. */
  :global(.page.is-menu-open) .site-header {
    color: #fff;
    background: var(--royal);
    box-shadow: none;
  }

  :global(.page.is-menu-open) .site-header .brand-logo.on-dark {
    opacity: 1;
  }

  :global(.page.is-menu-open) .site-header .brand-logo.on-light {
    opacity: 0;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--royal-bright);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .site-header.is-scrolled .progress {
    opacity: 1;
  }

  /*
   * 1080 px: o mesmo ponto do DESKTOP_QUERY em src/scripts/menu.ts. Com o espaçamento de texto do
   * visitante (WCAG 1.4.12), o botão desce para uma segunda linha em vez de ser cortado ou de sair
   * da tela.
   */
  @media (width >= 1080px) {
    .header-inner {
      flex-wrap: wrap;
    }

    .nav {
      display: flex;
    }

    .btn.btn-header {
      display: inline-flex;
    }

    .menu-toggle {
      display: none;
    }
  }

  /*
   * Entre 1080 e 1279 px, logo, navegação e botão dividem a linha: tudo um pouco mais junto. O
   * header completo pede ~1220 px de layout, e a barra de rolagem clássica (a do Windows) entra na
   * largura da media query: abaixo de 1280 px ele não cabe com folga.
   */
  @media (1080px <= width <= 1279px) {
    .header-inner {
      gap: 24px;
    }

    .nav {
      gap: 18px;
      font-size: var(--fs-sm);
    }

    .brand-logo {
      height: 40px;
    }

    .btn.btn-header {
      padding: 0 16px;
      letter-spacing: 0.06em;
    }
  }

  /*
   * No celular, o logo e o botão do menu dividem a linha com 16 px entre eles. O logo vai até
   * 240 px de largura e encolhe com a tela (360 px, barra de rolagem clássica), sem empurrar o botão.
   * O link fica do tamanho do logo, como no SimpleHeader.astro: crescendo até o Menu, ele levava
   * ao início também pelo vão vazio à direita do logo (até 86 px a 479 px), e o anel do foco
   * contornava esse vão. O margin-right: auto da regra base continua empurrando o Menu.
   */
  @media (width <= 479px) {
    .header-inner {
      gap: 16px;
    }

    .brand {
      flex: 0 1 240px;
      min-width: 0;
    }

    .brand-logo {
      width: 100%;
      height: auto;
    }
  }

  :global(.page.is-menu-open) .progress {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Recolhe e volta sem deslizar. */
    .site-header {
      transition-property: background-color, color, box-shadow;
    }

    :global(.page:not([data-entered])) .site-header {
      animation: fade 0.5s ease-out backwards !important;
    }

    /* O indicador troca de link sem deslizar. */
    .nav-ind {
      transition: opacity 0.4s;
    }

    /*
     * As barras viram X sem girar, e o header muda de altura sem animar. O logo continua
     * esmaecendo junto com o fundo e o texto (esmaecer não é movimento): trocado de estalo, ele
     * ficava um instante branco sobre o fundo claro, ou azul sobre o azul-noite.
     */
    .menu-icon::before,
    .menu-icon::after,
    .header-inner {
      transition: none;
    }

    /*
     * O preenchimento da chamada aparece sem deslizar (buttons.css), mas a troca de cor ainda
     * esmaece com o rótulo, como o logo.
     */
    .btn.btn-header::before {
      transition: background-color 0.4s var(--ease);
    }
  }

  /*
   * Alto contraste: as barras do menu e o indicador do link ativo são fundos, que o modo trocaria
   * pela cor da tela; ficam com a cor de sistema do texto.
   */
  @media (forced-colors: active) {
    .menu-icon::before,
    .menu-icon::after {
      forced-color-adjust: none;
      background: ButtonText;
    }

    .nav-ind {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  @media print {
    .site-header {
      display: none !important;
    }
  }
</style>
