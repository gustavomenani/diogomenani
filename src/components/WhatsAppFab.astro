---
import Icon from './Icon.astro';
import { externalLink } from '../lib/links';
import { messages, waLink } from '../lib/whatsapp';
---

<a
  class="fab"
  href={waLink(messages.default)}
  {...externalLink()}
  aria-label="Conversar pelo WhatsApp"
  data-fab
>
  <Icon name="whatsapp" />
  <span class="fab-label">WhatsApp</span>
</a>

<style>
  /*
   * Botão flutuante (só abaixo de 1080px): aparece depois do hero e some perto do contato. Fica no
   * HTML do rodapé, mas fixo na tela.
   */
  .fab {
    position: fixed;
    right: var(--fab-offset);
    bottom: var(--fab-offset);
    z-index: var(--z-fab);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: var(--fab-size);
    padding: 0 22px 0 18px;
    border-radius: var(--radius-pill);
    background: var(--royal);
    color: #fff;
    font-weight: 600;
    font-size: var(--fs-md);
    box-shadow:
      0 20px 44px -18px rgb(var(--royal-rgb) / 75%),
      inset 0 0 0 1px rgb(255 255 255 / 14%);

    /* Invisível na tela; no alto contraste vira o contorno do botão. */
    outline: 1px solid transparent;
    outline-offset: -1px;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 140%, 0);
    pointer-events: none;
    transition:
      transform 0.8s var(--ease),
      opacity 0.5s ease,
      background-color 0.3s,
      visibility 0s linear 0.8s;
  }

  .fab.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      transform 0.8s var(--ease),
      opacity 0.5s ease,
      background-color 0.3s,
      visibility 0s;
  }

  :global(.page.is-menu-open) .fab {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* No desktop (DESKTOP_QUERY em src/scripts/menu.ts) o header já mostra o botão de agendar. */
  @media (width >= 1080px) {
    .fab {
      display: none;
    }
  }

  @media (hover: hover) {
    .fab:hover {
      background: var(--royal-bright);
    }
  }

  /*
   * O botão flutua sobre fundos claros e royal: um anel branco entre ele e o contorno azul fica
   * visível nos dois. Vence o contorno branco do rodapé, onde o botão mora no HTML.
   */
  :global(.page .footer) .fab:focus-visible {
    outline: 2px solid var(--royal-bright);
    outline-offset: 2px;
    box-shadow:
      0 0 0 2px #fff,
      0 20px 44px -18px rgb(var(--royal-rgb) / 75%);
  }

  .fab :global(svg) {
    width: 22px;
    height: 22px;
  }

  @media (width <= 639px) {
    .fab {
      width: var(--fab-size);
      padding: 0;
    }

    .fab-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab {
      transition-duration: 0.2s !important;
      transform: none !important;
    }
  }

  @media print {
    .fab {
      display: none !important;
    }
  }
</style>
