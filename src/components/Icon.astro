---
import { iconPaths, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  strokeWidth?: number;
}

const { name, strokeWidth = 1.8 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {iconPaths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
