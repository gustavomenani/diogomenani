---
import Icon from './Icon.astro';
import Themis from './Themis.astro';
import { contact, defaultMessage, topics, waLink } from '../data/site';
---

<section class="hero is-royal" id="inicio" aria-labelledby="hero-title" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <span class="hero-glow" data-glow></span>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1
        class="hero-title"
        id="hero-title"
        aria-label="Clareza para entender. Firmeza para defender."
      >
        <span class="line" aria-hidden="true">
          <span class="w">
            <span>Clareza</span>
          </span>{' '}
          <span class="w">
            <span>para</span>
          </span>{' '}
          <span class="w">
            <span>entender.</span>
          </span>
        </span>{' '}
        <span class="line" aria-hidden="true">
          <span class="w">
            <span>Firmeza</span>
          </span>{' '}
          <span class="w">
            <span>para</span>
          </span>{' '}
          <span class="w">
            <span>defender.</span>
          </span>
        </span>
      </h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-lead">
        Advocacia e assessoria jurídica para pessoas e empresas, em {contact.city} e online. Você
        entende cada etapa do seu caso e decide com segurança.
      </p>
      <fieldset class="topic" data-topic>
        <legend class="topic-label">Sobre o que você quer conversar?</legend>
        <div class="chips">
          {topics.map((topic) => (
            <Fragment>
              <input
                class="chip-input"
                type="radio"
                name="tema"
                id={`tema-${topic.id}`}
                value={topic.id}
                data-cta={topic.cta}
                data-href={waLink(
                  `Olá, Dr. Diogo! Gostaria de agendar uma conversa sobre ${topic.area}.`,
                )}
              />
              <label class="chip" for={`tema-${topic.id}`}>
                {topic.label}
              </label>
            </Fragment>
          ))}
        </div>
      </fieldset>
      <div class="hero-actions">
        <a
          class="btn btn-light"
          href={waLink(defaultMessage)}
          target="_blank"
          rel="noopener"
          data-wa-cta
        >
          <Icon name="whatsapp" />
          <span class="btn-label" data-wa-label>
            Agendar uma conversa
          </span>
        </a>
        <a class="link-light" href="#como-trabalho">
          Como funciona o atendimento
        </a>
      </div>
    </div>
  </div>
  <div class="hero-figure" aria-hidden="true" data-figure>
    <div class="hero-figure-inner">
      <Themis />
    </div>
  </div>
  <div class="wrap hero-facts">
    <ul class="facts">
      <li>{contact.oab}</li>
      <li>{contact.city}</li>
      <li>Atendimento presencial e online</li>
    </ul>
  </div>
</section>
