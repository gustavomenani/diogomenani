---
import Themis from './Themis.astro';
import TopicPicker from './TopicPicker.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact } from '../data/contact';
import { anchor, sectionIds } from '../data/navigation';

/** Título em duas linhas; cada palavra sobe sozinha na animação de entrada. */
const TITLE_LINES = ['Clareza para entender.', 'Firmeza para defender.'];
/** Palavras de cada linha com o índice global, que escalona a animação (ver --word no CSS). */
const titleWords = TITLE_LINES.reduce<{ word: string; index: number }[][]>((lines, line) => {
  const start = lines.flat().length;
  return [...lines, line.split(' ').map((word, i) => ({ word, index: start + i }))];
}, []);
---

<section class="hero is-royal" id={sectionIds.top} aria-labelledby="hero-title" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <span class="glow hero-glow" data-glow></span>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title">
        {/* O texto para leitores de tela vai inteiro; as palavras animadas ficam aria-hidden. */}
        <span class="sr-only">{TITLE_LINES.join(' ')}</span>
        {titleWords.map((words, lineIndex) => (
          <Fragment>
            {lineIndex > 0 && ' '}
            <span class="line" aria-hidden="true" style={`--row:${lineIndex}`}>
              {words.map(({ word, index }, wordIndex) => (
                <Fragment>
                  {wordIndex > 0 && ' '}
                  <span class="w" style={`--word:${index}`}>
                    <span>{word}</span>
                  </span>
                </Fragment>
              ))}
            </span>
          </Fragment>
        ))}
      </h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-lead">
        Advocacia e assessoria jurídica para pessoas e empresas, em {contact.city} e online. Você
        entende cada etapa do seu caso e decide com segurança.
      </p>
      <TopicPicker />
      <div class="hero-actions">
        <WhatsAppButton label="Agendar uma conversa" data-wa-cta />
        <a class="link-light" href={anchor(sectionIds.process)}>
          Como funciona o atendimento
        </a>
      </div>
    </div>
  </div>
  <div class="hero-figure" aria-hidden="true" data-figure>
    <div class="hero-figure-inner">
      <Themis />
    </div>
  </div>
  <div class="wrap hero-facts">
    <ul class="facts">
      <li>{contact.oab}</li>
      <li>{contact.city}</li>
      <li>{contact.serviceMode}</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: clamp(700px, 100svh, 980px);
    padding-top: clamp(124px, 15svh, 176px);
    overflow: clip;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--royal);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, rgb(var(--shade-rgb) / 50%), rgb(var(--shade-rgb) / 0%));
  }

  /* O brilho do hero tem uma parada a mais no meio e se apaga antes da borda do círculo. */
  .hero-glow {
    --glow-size: min(1040px, 92vw);
    --glow-alpha: 46%;

    right: -6%;
    top: -14%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow-rgb) / var(--glow-alpha)),
      var(--glow-mid) 48%,
      rgb(var(--royal-rgb) / 0%) 74%
    );
    animation: fade 2.6s ease-out 0.25s backwards;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    padding-bottom: 48px;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(46px, 4.3vw + 6px, 72px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .hero-title .line {
    display: block;
  }

  /* A folga de 0,12em guarda as descendentes (g, p) dentro do overflow sem mudar as linhas. */
  .hero-title .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  /* Cada palavra sobe 60 ms depois da anterior, com um passo extra entre as linhas. */
  .hero-title .w > span {
    display: inline-block;
    animation: rise 1.15s var(--ease) backwards;
    animation-delay: calc(0.18s + (var(--word) + var(--row)) * 0.06s);
  }

  .hero-rule {
    position: relative;
    display: block;
    width: min(100%, 560px);
    height: 4px;
    margin: 32px 0 28px;
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0%) 0%,
      rgb(255 255 255 / 55%) 16%,
      #fff 40%,
      #fff 84%,
      rgb(255 255 255 / 0%) 100%
    );
    filter: drop-shadow(0 0 7px var(--rule-glow));
    transform-origin: left center;
    animation: draw 1.5s var(--ease) 0.62s backwards;
  }

  /* Brilho que percorre o traço uma vez, enquanto ele é desenhado. */
  .hero-rule::after {
    content: '';
    position: absolute;
    left: -48px;
    top: -7px;
    width: 100%;
    height: 18px;
    background: radial-gradient(
        closest-side,
        rgb(255 255 255 / 95%),
        var(--rule-spark) 60%,
        rgb(255 255 255 / 0%)
      )
      0 50% / 96px 18px no-repeat;
    opacity: 0;
    animation: spark 1.6s var(--ease-io) 0.62s backwards;
  }

  .hero-lead {
    max-width: 34em;
    font-size: clamp(17px, 0.3vw + 15px, 20px);
    line-height: 1.6;
    color: var(--sky);
    text-wrap: pretty;
    animation: fade-up 1s var(--ease) 0.7s backwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 30px;
    margin-top: 26px;
    animation: fade-up 1s var(--ease) 0.86s backwards;
  }

  .hero-figure {
    position: absolute;
    z-index: 1;
    right: max(-40px, calc(50% - 810px));
    bottom: 0;
    height: min(calc(100% - 108px), 880px, 58vw);
    aspect-ratio: 860 / 1112;
    pointer-events: none;
  }

  .hero-figure-inner {
    width: 100%;
    height: 100%;
    mask-repeat: no-repeat;
    animation: figure-unveil 2.3s var(--ease-soft) 0.05s backwards;
  }

  .hero-facts {
    position: relative;
    z-index: 2;
    padding-bottom: 30px;
    animation: fade 1.1s ease-out 1s backwards;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 0;
    padding-top: 22px;
    border-top: 1px solid var(--line-on-royal);
    font-size: var(--fs-sm);
    color: var(--sky);
  }

  .facts li {
    padding-right: 24px;
    margin-right: 24px;
    border-right: 1px solid var(--line-on-royal);
    line-height: 1.3;
  }

  .facts li:last-child {
    border-right: 0;
    margin-right: 0;
    padding-right: 0;
  }

  @media (960px <= width <= 1199px) {
    .hero-copy {
      max-width: 56%;
    }
  }

  @media (width <= 959px) {
    .hero {
      min-height: 0;
      padding-top: 120px;
    }

    .hero-grid {
      padding-bottom: 40px;
    }

    .hero-figure {
      right: -34%;
      height: min(68%, 580px);
      opacity: 0.17;
    }

    .hero-facts {
      padding-bottom: 26px;
    }

    .facts li {
      border-right: 0;
      margin-right: 22px;
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title .w > span,
    .hero-lead,
    .hero-actions,
    .hero-facts,
    .hero-figure-inner,
    .hero-rule {
      animation: fade 0.5s ease-out backwards !important;
    }

    .hero-rule::after {
      display: none;
    }
  }

  @media print {
    .hero {
      min-height: 0;
      padding-top: 48px;
    }

    .hero-figure-inner,
    .hero-title .w > span {
      animation: none !important;
    }
  }
</style>
