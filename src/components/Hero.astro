---
import Themis from './Themis.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact } from '../data/contact';
import { areas } from '../data/content';
import { anchor, sectionIds } from '../data/navigation';
import { messages, waLink } from '../lib/whatsapp';

/** Título em duas linhas; cada palavra sobe sozinha na animação de entrada. */
const TITLE_LINES = ['Clareza para entender.', 'Firmeza para defender.'];
const titleWords = TITLE_LINES.map((line) => line.split(' '));
---

<section class="hero is-royal" id={sectionIds.top} aria-labelledby="hero-title" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <span class="hero-glow" data-glow></span>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title" aria-label={TITLE_LINES.join(' ')}>
        {titleWords.map((words, lineIndex) => (
          <Fragment>
            {lineIndex > 0 && ' '}
            <span class="line" aria-hidden="true">
              {words.map((word, wordIndex) => (
                <Fragment>
                  {wordIndex > 0 && ' '}
                  <span class="w">
                    <span>{word}</span>
                  </span>
                </Fragment>
              ))}
            </span>
          </Fragment>
        ))}
      </h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-lead">
        Advocacia e assessoria jurídica para pessoas e empresas, em {contact.city} e online. Você
        entende cada etapa do seu caso e decide com segurança.
      </p>
      <fieldset class="topic" data-topic>
        <legend class="topic-label">Sobre o que você quer conversar?</legend>
        <div class="chips">
          {areas.map((area) => (
            <Fragment>
              <input
                class="chip-input"
                type="radio"
                name="tema"
                id={`tema-${area.id}`}
                value={area.id}
                data-cta={area.topic.cta}
                data-href={waLink(messages.topic(area.name))}
              />
              <label class="chip" for={`tema-${area.id}`}>
                {area.topic.label}
              </label>
            </Fragment>
          ))}
        </div>
      </fieldset>
      <div class="hero-actions">
        <WhatsAppButton label="Agendar uma conversa" data-wa-cta />
        <a class="link-light" href={anchor(sectionIds.process)}>
          Como funciona o atendimento
        </a>
      </div>
    </div>
  </div>
  <div class="hero-figure" aria-hidden="true" data-figure>
    <div class="hero-figure-inner">
      <Themis />
    </div>
  </div>
  <div class="wrap hero-facts">
    <ul class="facts">
      <li>{contact.oab}</li>
      <li>{contact.city}</li>
      <li>{contact.serviceMode}</li>
    </ul>
  </div>
</section>
