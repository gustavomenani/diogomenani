---
/** O monograma DM em SVG inline, desenhado direto (hoje, só no rodapé da home). */
import type { HTMLAttributes } from 'astro/types';
import { monogram } from '../data/brand';

type Props = HTMLAttributes<'svg'>;

const props = Astro.props;
---

<svg viewBox={monogram.viewBox} aria-hidden="true" focusable="false" {...props}>
  <path fill="currentColor" d={monogram.d} />
</svg>
