---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { contact } from '../data/contact';
import { credentials } from '../data/content';
import { sectionIds } from '../data/navigation';

// Foto por convenção: salve o retrato (vertical, 4:5) em src/assets/diogo.jpg (ou .jpeg, .png,
// .webp, em maiúsculas ou minúsculas) e ele entra no lugar do placeholder, otimizado pelo Astro.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/diogo.{jpg,jpeg,png,webp}', {
  eager: true,
  caseSensitive: false,
});
const photo = Object.values(photos)[0]?.default;
---

<section class="section about" id={sectionIds.about} aria-labelledby="sobre-title">
  <div class="wrap about-grid">
    <figure class="portrait" data-reveal="unveil">
      <div class="portrait-frame">
        {photo ? (
          <Image
            src={photo}
            alt="Diogo Menani"
            class="portrait-photo"
            widths={[340, 480, 680, 960]}
            sizes="(max-width: 639px) 340px, 480px"
          />
        ) : (
          <div class="portrait-art">
            <span class="portrait-glow" aria-hidden="true"></span>
            <span class="portrait-ph">
              <span class="portrait-ph-title">Foto de Diogo Menani</span>
              <span class="portrait-ph-sub">[retrato profissional vertical, 4:5]</span>
            </span>
          </div>
        )}
      </div>
    </figure>
    <div class="about-copy">
      <h2 class="h2 about-name" id="sobre-title" data-reveal="rise">
        Diogo Menani
      </h2>
      <p class="about-reg" data-reveal>
        Advogado inscrito na OAB/{contact.oabState} sob o nº {contact.oabNumber}
      </p>
      <div class="about-text" data-reveal>
        <p>
          Atuo na advocacia consultiva e contenciosa: oriento pessoas e empresas antes de decisões
          importantes e defendo seus interesses quando o conflito já existe.
        </p>
        <p>
          Meu trabalho começa pela escuta. Entendo a sua situação, explico as possibilidades em
          linguagem simples e definimos juntos o caminho mais seguro, com transparência sobre
          prazos, custos e riscos.
        </p>
      </div>
      <dl class="creds" data-reveal-list>
        {credentials.map((item) => (
          <div class="cred">
            <dt>{item.term}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 64px;
    align-items: center;
  }

  .portrait {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--royal);
  }

  .portrait-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 28px;
    transition: transform 2s var(--ease-soft);
  }

  .portrait-glow {
    position: absolute;
    right: -24%;
    top: -22%;
    width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow-rgb) / 50%),
      rgb(var(--royal-rgb) / 0%)
    );
  }

  .portrait-ph {
    position: relative;
    display: grid;
    gap: 10px;
    justify-items: center;
    text-align: center;
    color: #fff;
  }

  .portrait-ph-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 1vw + 16px, 30px);
    line-height: 1.15;
  }

  .portrait-ph-sub {
    font-size: 14px;
    color: var(--sky);
  }

  /* Enquanto o retrato não foi revelado, o desenho começa ampliado e encolhe ao aparecer. */
  :global(.page[data-motion='on']) [data-reveal='unveil']:not(.is-in) .portrait-art {
    transform: scale(1.14);
  }

  .about-name {
    margin-top: 6px;
  }

  .about-reg {
    margin-top: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(18px, 0.4vw + 15px, 21px);
    color: var(--royal);
  }

  .about-text {
    margin-top: 30px;
    max-width: 36em;
  }

  .about-text p {
    color: var(--ink-soft);
  }

  .about-text p + p {
    margin-top: 1em;
  }

  .creds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    column-gap: 40px;
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }

  .cred {
    padding: 18px 0 16px;
    border-bottom: 1px solid var(--line);
  }

  .cred dt {
    margin-bottom: 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--royal);
  }

  .cred dd {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
  }

  @media (width >= 960px) {
    .about-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(64px, 7vw, 120px);
    }
  }

  @media (width <= 639px) {
    .portrait {
      max-width: 340px;
    }
  }
</style>
