---
/**
 * Campo de formulário: rótulo, controle (no slot) e mensagem de erro.
 * O script encontra o erro de cada controle por `[data-field]` → `[data-field-error]`.
 */
interface Props {
  /** Id do controle do slot; o erro recebe o id `${id}-erro`. */
  id: string;
  label: string;
  /** Mensagem mostrada quando o campo é inválido; campos sem validação não têm. */
  error?: string;
  optional?: boolean;
}

const { id, label, error, optional = false } = Astro.props;
---

<div class="field" data-field>
  <label for={id}>
    {label}
    {optional && (
      <Fragment>
        {' '}
        <span class="opt">(opcional)</span>
      </Fragment>
    )}
  </label>
  <slot />
  {error && (
    <p class="field-error" id={`${id}-erro`} data-field-error>
      {error}
    </p>
  )}
</div>
