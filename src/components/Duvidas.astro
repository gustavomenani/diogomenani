---
import { faq } from '../data/content';
import { sectionIds } from '../data/navigation';
---

<section class="section faq" id={sectionIds.faq} aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-head">
      <h2 class="h2" id="faq-title" data-reveal="rise">
        Dúvidas frequentes
      </h2>
      <p class="lede" data-reveal>
        Respostas rápidas para quem está procurando um advogado, talvez pela primeira vez.
      </p>
    </div>
    <div class="faq-list" data-reveal-list>
      {faq.map((item, i) => {
        const open = i === 0;
        const n = i + 1;
        return (
          <div class:list={['faq-item', { 'is-open': open }]} data-faq-item>
            <h3>
              <button
                class="faq-btn"
                type="button"
                id={`faq-b${n}`}
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={`faq-p${n}`}
                data-faq-btn
              >
                <span>{item.question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </button>
            </h3>
            <section class="faq-panel" id={`faq-p${n}`} aria-labelledby={`faq-b${n}`}>
              <div class="faq-panel-inner">
                <p>{item.answer}</p>
              </div>
            </section>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: 40px;
  }

  .faq-head .lede {
    margin-top: 22px;
    max-width: 28em;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 26px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(20px, 0.5vw + 16px, 24px);
    line-height: 1.3;
    color: var(--royal);
    font-variation-settings: 'opsz' 22;
  }

  /* Ícone de mais/menos: o traço vertical (::after) gira até sumir quando a pergunta abre. */
  .faq-icon {
    position: relative;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--royal);
    box-shadow: inset 0 0 0 1px #c5cde8;
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
    transition: transform 0.6s var(--ease);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq-btn:hover .faq-icon {
    box-shadow: inset 0 0 0 1px var(--royal);
  }

  .faq-item.is-open .faq-icon {
    background: var(--royal);
    color: #fff;
    box-shadow: inset 0 0 0 1px var(--royal);
  }

  .faq-item.is-open .faq-icon::after {
    transform: rotate(0deg);
  }

  /* Sem JavaScript, todas as respostas ficam abertas; com ele, só as marcadas com is-open. */
  .faq-panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(.page:not([data-motion='pending'])) .faq-panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.6s var(--ease),
      visibility 0s linear 0.6s;
  }

  :global(.page) .faq-item.is-open .faq-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.6s var(--ease),
      visibility 0s;
  }

  .faq-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq-panel-inner p {
    padding: 0 62px 28px 0;
    max-width: 40em;
    color: var(--ink-soft);
    transition:
      opacity 0.35s ease,
      transform 0.6s var(--ease);
  }

  :global(.page:not([data-motion='pending'])) .faq-item:not(.is-open) .faq-panel-inner p {
    opacity: 0;
    transform: translate3d(0, -8px, 0);
  }

  :global(.page) .faq-item.is-open .faq-panel-inner p {
    transition-delay: 0.1s;
  }

  @media (width >= 960px) {
    .faq-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 104px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-panel-inner p {
      transition: none !important;
    }
  }
</style>
