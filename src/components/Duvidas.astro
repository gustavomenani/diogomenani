---
import { faq } from '../data/content';
import { sectionIds } from '../data/navigation';
---

<section class="section faq" id={sectionIds.faq} aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-head">
      <h2 class="h2" id="faq-title" data-reveal="rise">
        Dúvidas frequentes
      </h2>
      <p class="lede" data-reveal>
        Respostas rápidas para quem está procurando um advogado, talvez pela primeira vez.
      </p>
    </div>
    <div class="faq-list" data-reveal-list>
      {faq.map((item, i) => {
        const open = i === 0;
        const n = i + 1;
        return (
          <div class:list={['faq-item', { 'is-open': open }]} data-faq-item>
            <h3>
              {/* Sem JavaScript, todas abertas; o faq.ts acerta o aria-expanded ao iniciar. */}
              <button
                class="faq-btn"
                type="button"
                id={`faq-b${n}`}
                aria-expanded="true"
                aria-controls={`faq-p${n}`}
                data-faq-btn
              >
                <span class="faq-question">{item.question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </button>
            </h3>
            {/* <div>, não <section>: cinco regiões a mais poluiriam a navegação por landmarks. */}
            <div class="faq-panel" id={`faq-p${n}`}>
              <div class="faq-panel-inner">
                <p>{item.answer}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: 40px;
  }

  .faq-head .lede {
    margin-top: 22px;
    max-width: 28em;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 26px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(20px, 0.5vw + 16px, 24px);
    line-height: 1.3;
    color: var(--royal);
  }

  /* balance, como nos títulos (.h2): sem "separar?" ou "honorários?" sozinho na segunda linha. */
  .faq-question {
    text-wrap: balance;
    transition: color 0.3s var(--ease);
  }

  /* Ícone de mais/menos: o traço vertical (::after) gira até sumir quando a pergunta abre. */
  .faq-icon {
    position: relative;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--royal);
    box-shadow: inset 0 0 0 1px var(--faq-ring);

    /* Invisível na tela; no alto contraste vira o anel do ícone. */
    outline: 1px solid transparent;
    outline-offset: -1px;
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
    transition: transform 0.6s var(--ease);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq-item.is-open .faq-icon {
    background: var(--royal);
    color: #fff;
    box-shadow: inset 0 0 0 1px var(--royal);
  }

  /*
   * O hover vale com a pergunta aberta e fechada: o anel do ícone sozinho não mudava nada na
   * aberta, que já tem o anel royal, e na fechada era 1 px num círculo de 38. A pergunta clareia
   * para o royal-bright (7:1 no branco), como os links; aberto, o círculo royal cheio clareia
   * também, como o botão flutuante e a chamada do header.
   */
  @media (hover: hover) {
    .faq-btn:hover .faq-question {
      color: var(--royal-bright);
    }

    .faq-btn:hover .faq-icon {
      box-shadow: inset 0 0 0 1px var(--royal);
    }

    .faq-item.is-open .faq-btn:hover .faq-icon {
      background: var(--royal-bright);
      box-shadow: inset 0 0 0 1px var(--royal-bright);
    }
  }

  .faq-item.is-open .faq-icon::after {
    transform: rotate(0deg);
  }

  /* Sem JavaScript, todas as respostas ficam abertas; com ele, só as marcadas com is-open. */
  .faq-panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(.page:not([data-motion='pending'])) .faq-panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.6s var(--ease),
      visibility 0s linear 0.6s;
  }

  :global(.page) .faq-item.is-open .faq-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.6s var(--ease),
      visibility 0s;
  }

  .faq-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* pretty: sem uma palavra sozinha na última linha, como nos textos de abertura (.lede). */
  .faq-panel-inner p {
    padding: 0 0 28px;
    max-width: 40em;
    color: var(--ink-soft);
    text-wrap: pretty;
    transition:
      opacity 0.35s ease,
      transform 0.6s var(--ease);
  }

  :global(.page:not([data-motion='pending'])) .faq-item:not(.is-open) .faq-panel-inner p {
    opacity: 0;
    transform: translate3d(0, -8px, 0);
  }

  :global(.page) .faq-item.is-open .faq-panel-inner p {
    transition-delay: 0.1s;
  }

  /*
   * A partir de 640 px, 62 px à direita (o ícone, 38, mais o espaço, 24): a resposta termina na
   * mesma borda da pergunta acima. No celular, o recuo só estreitaria a coluna (258 px a 360), já
   * que o ícone fica na linha da pergunta, e não ao lado da resposta.
   */
  @media (width >= 640px) {
    .faq-panel-inner p {
      padding-right: 62px;
    }
  }

  /* Piso de 310 px, o mesmo da .areas-grid (Areas.astro): as colunas das duas seções batem. */
  @media (width >= 960px) {
    .faq-grid {
      grid-template-columns: minmax(310px, 4fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 104px);
    }
  }

  /* Com movimento reduzido, a resposta abre direto e o + vira − sem girar. */
  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-panel-inner p,
    .faq-icon::before,
    .faq-icon::after {
      transition: none !important;
    }
  }

  /* Alto contraste: os traços do ± são fundos, que o modo trocaria pela cor da tela. */
  @media (forced-colors: active) {
    .faq-icon::before,
    .faq-icon::after {
      forced-color-adjust: none;
      background: ButtonText;
    }
  }

  /* Na impressão, todas as respostas aparecem. */
  @media print {
    .faq-panel {
      grid-template-rows: 1fr !important;
      visibility: visible !important;
      transition: none !important;
    }

    .faq-panel-inner p {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
