---
import { steps } from '../data/content';
import { sectionIds } from '../data/navigation';
---

<section class="section process" id={sectionIds.process} aria-labelledby="process-title">
  <div class="wrap">
    <div class="process-head">
      <h2 class="h2" id="process-title" data-reveal="rise">
        Como trabalhamos
      </h2>
      <p class="lede" data-reveal>
        Cada cliente recebe orientação jurídica de forma clara, estratégias bem definidas e
        atualizações sobre seu caso, com transparência do início ao fim.
      </p>
    </div>
    {/* role="list": sem ele, o VoiceOver ignora listas com list-style: none (e a ordem das etapas). */}
    <ol class="steps" role="list" data-reveal-list>
      {steps.map((step, i) => (
        <li class="step" data-step>
          <span class="step-dot" aria-hidden="true"></span>
          <span class="step-num" aria-hidden="true">
            <span class="step-label">Etapa</span>
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="step-title">{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-head {
    display: grid;
    gap: 22px;
    margin-bottom: 72px;
  }

  .process-head .lede {
    max-width: 30em;
  }

  /* Linha do tempo vertical em todas as larguras: uma etapa abaixo da outra. */
  .steps {
    /* O trilho de cada etapa atravessa este espaço até a seguinte. */
    --steps-gap: 44px;

    display: grid;
    gap: var(--steps-gap);
  }

  .step {
    position: relative;
    padding-left: 52px;
  }

  /* Trilho entre as etapas: ::before é a linha clara; ::after, o progresso em royal. */
  .step::before,
  .step::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 20px;
    width: 1px;
    height: calc(100% + var(--steps-gap) - 14px);
  }

  .step::before {
    background: var(--line);
  }

  .step::after {
    background: var(--royal);
    transform-origin: center top;
    transition: transform 1.1s var(--ease);
  }

  .step:last-child::before,
  .step:last-child::after {
    display: none;
  }

  /*
   * As duas sombras ficam nos dois estados, na mesma ordem (o anel inset e o halo): uma inset e
   * uma externa não se interpolam, e o halo surgiria de estalo enquanto o ponto ainda cresce.
   */
  .step-dot {
    position: absolute;
    left: 0;
    top: 6px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--royal);
    box-shadow:
      inset 0 0 0 1px transparent,
      0 0 0 6px rgb(var(--royal-bright-rgb) / 12%);
    transition:
      background-color 0.6s var(--ease),
      box-shadow 0.6s var(--ease),
      transform 0.7s var(--ease);
  }

  .step-num {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 1.6vw + 22px, 52px);
    line-height: 1;
    color: var(--royal);
    transition: color 0.7s var(--ease);
  }

  /*
   * Cor própria, e não herdada do número, com a mesma transição: o rótulo vai do tom apagado
   * direto ao royal. Herdando, ele acompanharia a transição do número, e o WebKit reiniciaria a
   * dele a cada quadro.
   */
  .step-label {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--royal);
    transition: color 0.7s var(--ease);
  }

  .step-title {
    margin-top: 16px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 0.5vw + 18px, 26px);
    line-height: 1.2;
    color: var(--royal);
  }

  /* pretty: sem uma palavra sozinha na última linha, como nos textos de abertura (.lede). */
  .step p {
    margin-top: 10px;
    max-width: 36em;
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /*
   * Com movimento, as etapas acendem conforme a leitura avança (is-active e is-done no script).
   * Só na tela: impressas, saem todas acesas. O número apagado ainda tem 3:1 sobre o branco (texto
   * grande); o rótulo "Etapa", pequeno, tem cor própria, com 4,5:1.
   */
  @media screen {
    :global(.page[data-motion='on']) .step:not(.is-active) .step-num {
      color: var(--step-idle);
    }

    :global(.page[data-motion='on']) .step:not(.is-active) .step-label {
      color: var(--step-idle-label);
    }

    :global(.page[data-motion='on']) .step:not(.is-active) .step-dot {
      background: #fff;
      box-shadow:
        inset 0 0 0 1px var(--step-idle-ring),
        0 0 0 0 rgb(var(--royal-bright-rgb) / 0%);
      transform: scale(0.85);
    }

    :global(.page[data-motion='on']) .step:not(.is-done)::after {
      transform: scaleY(0);
    }
  }

  /*
   * Alto contraste: o trilho, o progresso e os pontos são fundos e sombras, que o modo trocaria pela
   * cor da tela (e tiraria), e a linha do tempo sumiria inteira. Ficam com as cores do sistema, como
   * as barras do menu e o ± do FAQ; o ponto apagado vira um anel.
   */
  @media (forced-colors: active) {
    .step::before,
    .step::after,
    .step-dot {
      forced-color-adjust: none;
    }

    .step::before {
      background: GrayText;
    }

    .step::after {
      background: CanvasText;
    }

    .step-dot {
      background: CanvasText;
      box-shadow: none;
    }

    :global(.page[data-motion='on']) .step:not(.is-active) .step-dot {
      background: Canvas;
      box-shadow: inset 0 0 0 1px CanvasText;
    }
  }

  /* No desktop, o número fica numa coluna e o texto da etapa na outra, como uma linha do tempo. */
  @media (width >= 960px) {
    .process-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 64px;
    }

    .steps {
      --steps-gap: 56px;

      max-width: 980px;
    }

    .step {
      display: grid;
      grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
      column-gap: 48px;
      padding-left: 64px;
    }

    .step-title {
      margin-top: 0;
    }
  }
</style>
