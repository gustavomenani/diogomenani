---
import { steps } from '../data/content';
import { sectionIds } from '../data/navigation';
---

<section class="section process" id={sectionIds.process} aria-labelledby="process-title">
  <div class="wrap">
    <div class="process-head">
      <h2 class="h2" id="process-title" data-reveal="rise">
        Como funciona o atendimento
      </h2>
      <p class="lede" data-reveal>
        Do primeiro contato ao encerramento do caso, você sabe o que está sendo feito e qual é o
        próximo passo.
      </p>
    </div>
    <ol class="steps" data-reveal-list>
      {steps.map((step, i) => (
        <li class="step" data-step>
          <span class="step-dot" aria-hidden="true"></span>
          <span class="step-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="step-title">{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-head {
    display: grid;
    gap: 22px;
    margin-bottom: 72px;
  }

  .process-head .lede {
    max-width: 30em;
  }

  .steps {
    /* O trilho de cada etapa atravessa este espaço até a seguinte. */
    --steps-gap: 44px;

    display: grid;
    gap: var(--steps-gap);
  }

  .step {
    position: relative;
    padding-left: 52px;
  }

  /* Trilho entre as etapas: ::before é a linha clara; ::after, o progresso em royal. */
  .step::before,
  .step::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 20px;
    width: 1px;
    height: calc(100% + var(--steps-gap) - 14px);
  }

  .step::before {
    background: var(--line);
  }

  .step::after {
    background: var(--royal);
    transform-origin: center top;
    transition: transform 1.1s var(--ease);
  }

  .step:last-child::before,
  .step:last-child::after {
    display: none;
  }

  .step-dot {
    position: absolute;
    left: 0;
    top: 6px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--royal);
    box-shadow: 0 0 0 6px rgb(var(--royal-bright-rgb) / 12%);
    transition:
      background-color 0.6s var(--ease),
      box-shadow 0.6s var(--ease),
      transform 0.7s var(--ease);
  }

  .step-num {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 2vw + 22px, 58px);
    line-height: 1;
    color: var(--royal);
    transition: color 0.7s var(--ease);
  }

  .step-title {
    margin-top: 16px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 0.5vw + 18px, 26px);
    line-height: 1.2;
    color: var(--royal);
  }

  .step p {
    margin-top: 10px;
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /*
   * Com movimento, as etapas acendem conforme a leitura avança (is-active e is-done no script).
   * Só na tela: impressas, saem todas acesas. O número apagado ainda tem 3:1 sobre o branco.
   */
  @media screen {
    :global(.page[data-motion='on']) .step:not(.is-active) .step-num {
      color: var(--step-idle);
    }

    :global(.page[data-motion='on']) .step:not(.is-active) .step-dot {
      background: #fff;
      box-shadow: inset 0 0 0 1px var(--step-idle-ring);
      transform: scale(0.85);
    }

    :global(.page[data-motion='on']) .step:not(.is-done)::after {
      transform: scaleY(0);
    }
  }

  @media (width >= 960px) {
    .process-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 64px;
    }

    .steps {
      --steps-gap: 40px;

      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .step {
      padding-left: 0;
      padding-top: 52px;
    }

    .step::before,
    .step::after {
      left: 20px;
      top: 6px;
      width: calc(100% + var(--steps-gap) - 14px);
      height: 1px;
    }

    .step::after {
      transform-origin: left center;
    }

    .step-dot {
      top: 0;
    }
  }

  @media screen and (width >= 960px) {
    :global(.page[data-motion='on']) .step:not(.is-done)::after {
      transform: scaleX(0);
    }
  }
</style>
