---
import Icon from './Icon.astro';
import { areas } from '../data/content';
import { sectionIds } from '../data/navigation';
import { EXTERNAL_LINK } from '../lib/links';
import { messages, waLink } from '../lib/whatsapp';
---

<section class="section areas" id={sectionIds.areas} aria-labelledby="atuacao-title">
  <div class="wrap areas-grid">
    <div class="areas-head">
      <h2 class="h2" id="atuacao-title" data-reveal="rise">
        Áreas de atuação
      </h2>
      <p class="lede" data-reveal>
        Atuação consultiva, para prevenir problemas e orientar decisões, e contenciosa, para
        defender seus direitos quando o conflito já existe.
      </p>
      <p class="areas-note" data-reveal>
        Não encontrou o seu caso?{' '}
        <a class="link" href={waLink(messages.unlistedCase)} {...EXTERNAL_LINK}>
          Envie uma mensagem
        </a>{' '}
        e eu digo se posso ajudar.
      </p>
    </div>
    <ul class="area-list" data-reveal-list>
      {areas.map((area) => (
        <li class="area">
          <a class="area-link" href={waLink(messages.area(area.name))} {...EXTERNAL_LINK}>
            <span class="area-body">
              <span class="area-name">{area.name}</span>
              <span class="area-desc">{area.description}</span>
            </span>
            <span class="area-go">
              Conversar <Icon name="arrow-up-right" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
