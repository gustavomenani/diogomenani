---
import type { HTMLAttributes } from 'astro/types';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import { messages, waLink } from '../lib/whatsapp';

/** Destino e abertura em outra aba são do componente: quem usa não os troca. */
type Props = Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'> & {
  /** Texto do botão. */
  label: string;
  /** Chamada principal: caixa alta espaçada e seta depois do texto. */
  cta?: boolean;
};

const { label, cta = false, class: className, ...attrs } = Astro.props;
---

<ExternalLink
  class={['btn btn-light', cta && 'btn-caps', className].filter(Boolean).join(' ')}
  href={waLink(messages.default)}
  {...attrs}
>
  <Icon name="whatsapp" />
  <span class="btn-label" data-wa-label>
    {label}
  </span>
  {/*
    Na chamada, o destino só aparece no ícone, que o leitor de tela não lê: ele ouve "pelo
    WhatsApp" depois do rótulo. Fica fora do [data-wa-label], que o seletor de tema reescreve.
  */}
  {cta && <span class="sr-only">{' pelo WhatsApp'}</span>}
  {cta && <Icon name="arrow-right" />}
</ExternalLink>
