---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import { externalLink } from '../lib/links';
import { messages, waLink } from '../lib/whatsapp';

/** Destino e abertura em outra aba são do componente: quem usa não os troca. */
type Props = Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'> & {
  /** Texto do botão. */
  label: string;
};

const { label, class: className, ...attrs } = Astro.props;
---

<a
  class:list={['btn btn-light', className]}
  href={waLink(messages.default)}
  {...externalLink()}
  {...attrs}
>
  <Icon name="whatsapp" />
  <span class="btn-label" data-wa-label>
    {label}
  </span>
</a>
