---
import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact, whatsapp } from '../data/contact';
import type { IconName } from '../data/icons';
import { sectionIds } from '../data/navigation';
import { externalLink } from '../lib/links';
import { waLink } from '../lib/whatsapp';

interface ContactItem {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  /** Abre em outra aba. */
  external?: boolean;
}

const items: readonly ContactItem[] = [
  { icon: 'whatsapp', label: 'WhatsApp', value: whatsapp.display, href: waLink(), external: true },
  { icon: 'mail', label: 'E-mail', value: contact.email.label, href: contact.email.href },
  { icon: 'map-pin', label: 'Escritório', value: contact.address },
  { icon: 'clock', label: 'Horário', value: contact.hours },
];
---

<section class="section contact is-royal" id={sectionIds.contact} aria-labelledby="contact-title">
  <span class="contact-glow" aria-hidden="true"></span>
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 class="h2" id="contact-title" data-reveal="rise">
        Vamos conversar sobre o seu caso?
      </h2>
      <p class="lede" data-reveal>
        Conte brevemente o que está acontecendo. O retorno é feito em horário comercial, pelo canal
        que você preferir.
      </p>
      <div class="contact-cta" data-reveal>
        <WhatsAppButton label="Conversar pelo WhatsApp" />
      </div>
      {/* role="list": sem ele, o VoiceOver ignora listas com list-style: none. */}
      <ul class="contact-list" role="list" data-reveal-list>
        {items.map((item) => (
          <li>
            <span class="cl-icon" aria-hidden="true">
              <Icon name={item.icon} />
            </span>
            <span>
              <span class="cl-label">{item.label}</span>
              {item.href ? (
                <a class="cl-value" href={item.href} {...(item.external ? externalLink() : {})}>
                  {item.value}
                </a>
              ) : (
                <span class="cl-value">{item.value}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <ContactForm />
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }

  .contact-glow {
    position: absolute;
    right: -18%;
    top: -40%;
    width: min(1000px, 100vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow-rgb) / 36%),
      rgb(var(--royal-rgb) / 0%)
    );
    pointer-events: none;
  }

  .contact-grid {
    position: relative;
    display: grid;
    gap: 64px;
    align-items: start;
  }

  .contact-copy .lede {
    margin-top: 22px;
    max-width: 30em;
  }

  .contact-cta {
    margin-top: 36px;
  }

  .contact-list {
    display: grid;
    gap: 22px;
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--line-on-royal);
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .cl-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 28%);
  }

  .cl-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .cl-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--sky-dim);
  }

  /* Um e-mail longo quebra em qualquer ponto em vez de sair da tela. */
  .cl-value {
    display: block;
    font-size: 17px;
    line-height: 1.45;
    color: #fff;
    overflow-wrap: anywhere;
  }

  a.cl-value {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    text-decoration-color: rgb(255 255 255 / 35%);
    transition: text-decoration-color 0.3s;
  }

  @media (hover: hover) {
    a.cl-value:hover {
      text-decoration-color: #fff;
    }
  }

  @media (width >= 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(56px, 6vw, 112px);
    }
  }
</style>
