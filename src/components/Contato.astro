---
import Field from './Field.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact, whatsapp } from '../data/contact';
import { areas } from '../data/content';
import type { IconName } from '../data/icons';
import { sectionIds } from '../data/navigation';
import { EXTERNAL_LINK } from '../lib/links';
import { waLink } from '../lib/whatsapp';

interface ContactItem {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  /** Abre em outra aba. */
  external?: boolean;
}

const items: readonly ContactItem[] = [
  { icon: 'whatsapp', label: 'WhatsApp', value: whatsapp.display, href: waLink(), external: true },
  { icon: 'mail', label: 'E-mail', value: contact.email.label, href: contact.email.href },
  { icon: 'map-pin', label: 'Escritório', value: contact.address },
  { icon: 'clock', label: 'Horário', value: contact.hours },
];
---

<section class="section contact is-royal" id={sectionIds.contact} aria-labelledby="contact-title">
  <span class="contact-glow" aria-hidden="true"></span>
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 class="h2" id="contact-title" data-reveal="rise">
        Vamos conversar sobre o seu caso?
      </h2>
      <p class="lede" data-reveal>
        Conte brevemente o que está acontecendo. O retorno é feito em horário comercial, pelo canal
        que você preferir.
      </p>
      <div class="contact-cta" data-reveal>
        <WhatsAppButton label="Conversar pelo WhatsApp" />
      </div>
      <ul class="contact-list" data-reveal-list>
        {items.map((item) => (
          <li>
            <span class="cl-icon" aria-hidden="true">
              <Icon name={item.icon} />
            </span>
            <span>
              <span class="cl-label">{item.label}</span>
              {item.href ? (
                <a class="cl-value" href={item.href} {...(item.external ? EXTERNAL_LINK : {})}>
                  {item.value}
                </a>
              ) : (
                <span class="cl-value">{item.value}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
    {/* O formulário depende de JavaScript por design: o script valida e monta a mensagem. */}
    <form class="contact-form" method="post" data-contact-form data-reveal novalidate>
      <h3 class="form-title">Prefere escrever?</h3>
      <p class="form-sub">Preencha os campos e a mensagem chega pronta no WhatsApp.</p>
      <div class="fields">
        <Field id="f-nome" label="Nome" error="Informe seu nome.">
          <input
            id="f-nome"
            name="nome"
            type="text"
            autocomplete="name"
            placeholder="Como posso chamar você?"
            required
          />
        </Field>
        <div class="field-row">
          <Field id="f-tel" label="WhatsApp" error="Informe um número com DDD.">
            <input
              id="f-tel"
              name="telefone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="(00) 00000-0000"
              required
            />
          </Field>
          <Field id="f-email" label="E-mail" optional error="Confira o e-mail digitado.">
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="voce@email.com"
            />
          </Field>
        </div>
        <Field id="f-assunto" label="Assunto" optional>
          <div class="select">
            <select id="f-assunto" name="assunto">
              <option value="">Escolha uma área</option>
              {areas.map((area) => (
                <option value={area.name}>{area.name}</option>
              ))}
              <option value="Outro assunto">Outro assunto</option>
            </select>
            <Icon name="chevron-down" />
          </div>
        </Field>
        <Field id="f-msg" label="Mensagem" error="Escreva uma mensagem curta sobre o seu caso.">
          <textarea
            id="f-msg"
            name="mensagem"
            rows="4"
            maxlength="1200"
            placeholder="Conte em poucas linhas o que está acontecendo."
            required
          ></textarea>
        </Field>
        <label class="check">
          <input class="check-input" type="checkbox" name="lgpd" required />
          <span class="check-box" aria-hidden="true">
            <Icon name="check" strokeWidth={2.6} />
          </span>
          <span>
            Concordo com o uso dos meus dados apenas para o retorno deste contato, conforme a LGPD.
          </span>
        </label>
        <p class="field-error" id="e-lgpd">
          Para continuar, confirme o uso dos dados.
        </p>
        <button class="btn btn-royal btn-block" type="submit">
          <Icon name="whatsapp" />
          <span class="btn-label">Enviar pelo WhatsApp</span>
        </button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <a class="form-fallback" href={waLink()} {...EXTERNAL_LINK} data-form-fallback>
          Se o WhatsApp não abriu, toque aqui para enviar a mensagem.
        </a>
      </div>
    </form>
  </div>
</section>
