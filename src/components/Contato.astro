---
import Field from './Field.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { contact, whatsapp } from '../data/contact';
import { areas } from '../data/content';
import type { IconName } from '../data/icons';
import { sectionIds } from '../data/navigation';
import { externalLink } from '../lib/links';
import { waLink } from '../lib/whatsapp';

interface ContactItem {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  /** Abre em outra aba. */
  external?: boolean;
}

const items: readonly ContactItem[] = [
  { icon: 'whatsapp', label: 'WhatsApp', value: whatsapp.display, href: waLink(), external: true },
  { icon: 'mail', label: 'E-mail', value: contact.email.label, href: contact.email.href },
  { icon: 'map-pin', label: 'Escritório', value: contact.address },
  { icon: 'clock', label: 'Horário', value: contact.hours },
];
---

<section class="section contact is-royal" id={sectionIds.contact} aria-labelledby="contact-title">
  <span class="contact-glow" aria-hidden="true"></span>
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 class="h2" id="contact-title" data-reveal="rise">
        Vamos conversar sobre o seu caso?
      </h2>
      <p class="lede" data-reveal>
        Conte brevemente o que está acontecendo. O retorno é feito em horário comercial, pelo canal
        que você preferir.
      </p>
      <div class="contact-cta" data-reveal>
        <WhatsAppButton label="Conversar pelo WhatsApp" />
      </div>
      <ul class="contact-list" data-reveal-list>
        {items.map((item) => (
          <li>
            <span class="cl-icon" aria-hidden="true">
              <Icon name={item.icon} />
            </span>
            <span>
              <span class="cl-label">{item.label}</span>
              {item.href ? (
                <a class="cl-value" href={item.href} {...(item.external ? externalLink() : {})}>
                  {item.value}
                </a>
              ) : (
                <span class="cl-value">{item.value}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
    {/* O formulário depende de JavaScript por design: o script valida e monta a mensagem. */}
    <form class="contact-form" method="post" data-contact-form data-reveal novalidate>
      <h3 class="form-title">Prefere escrever?</h3>
      <p class="form-sub">Preencha os campos e a mensagem chega pronta no WhatsApp.</p>
      <div class="fields">
        <Field id="f-nome" label="Nome" error="Informe seu nome.">
          <input
            id="f-nome"
            name="nome"
            type="text"
            autocomplete="name"
            placeholder="Como posso chamar você?"
            required
          />
        </Field>
        <div class="field-row">
          <Field id="f-tel" label="WhatsApp" error="Informe um número com DDD.">
            <input
              id="f-tel"
              name="telefone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="(00) 00000-0000"
              required
            />
          </Field>
          <Field id="f-email" label="E-mail" optional error="Confira o e-mail digitado.">
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="voce@email.com"
            />
          </Field>
        </div>
        <Field id="f-assunto" label="Assunto" optional>
          <div class="select">
            <select id="f-assunto" name="assunto">
              <option value="">Escolha uma área</option>
              {areas.map((area) => (
                <option value={area.name}>{area.name}</option>
              ))}
              <option value="Outro assunto">Outro assunto</option>
            </select>
            <Icon name="chevron-down" />
          </div>
        </Field>
        <Field id="f-msg" label="Mensagem" error="Escreva uma mensagem curta sobre o seu caso.">
          <textarea
            id="f-msg"
            name="mensagem"
            rows="4"
            maxlength="1200"
            placeholder="Conte em poucas linhas o que está acontecendo."
            required
          ></textarea>
        </Field>
        {/* Contêiner próprio (não .field): as regras de .field label/input pegariam o checkbox. */}
        <div class="check-field" data-field>
          <label class="check">
            <input class="check-input" id="f-lgpd" type="checkbox" name="lgpd" required />
            <span class="check-box" aria-hidden="true">
              <Icon name="check" strokeWidth={2.6} />
            </span>
            <span>
              Concordo com o uso dos meus dados apenas para o retorno deste contato, conforme a
              LGPD.
            </span>
          </label>
          <p class="field-error" id="f-lgpd-erro" data-field-error>
            Para continuar, confirme o uso dos dados.
          </p>
        </div>
        <button class="btn btn-royal btn-block" type="submit">
          <Icon name="whatsapp" />
          <span class="btn-label">Enviar pelo WhatsApp</span>
        </button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <a class="form-fallback" href={waLink()} {...externalLink()} data-form-fallback>
          Se o WhatsApp não abriu, toque aqui para enviar a mensagem.
        </a>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }

  .contact-glow {
    position: absolute;
    right: -18%;
    top: -40%;
    width: min(1000px, 100vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(96 122 255 / 36%), rgb(0 22 123 / 0%));
    pointer-events: none;
  }

  .contact-grid {
    position: relative;
    display: grid;
    gap: 64px;
    align-items: start;
  }

  .contact-copy .lede {
    margin-top: 22px;
    max-width: 30em;
  }

  .contact-cta {
    margin-top: 36px;
  }

  .contact-list {
    display: grid;
    gap: 22px;
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--line-royal);
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .cl-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 28%);
  }

  .cl-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .cl-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--sky-dim);
  }

  .cl-value {
    display: block;
    font-size: 17px;
    line-height: 1.45;
    color: #fff;
  }

  a.cl-value {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    text-decoration-color: rgb(255 255 255 / 35%);
    transition: text-decoration-color 0.3s;
  }

  a.cl-value:hover {
    text-decoration-color: #fff;
  }

  .contact-form {
    position: relative;
    padding: clamp(28px, 3vw, 44px);
    border-radius: 28px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 48px 90px -44px rgb(0 4 36 / 85%);
  }

  .form-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 0.8vw + 20px, 32px);
    line-height: 1.15;
    color: var(--royal);
    font-variation-settings: 'opsz' 22;
  }

  .form-sub {
    margin-top: 8px;
    font-size: 15px;
    color: var(--ink-soft);
  }

  .fields {
    display: grid;
    gap: 18px;
    margin-top: 28px;
  }

  .form-status {
    min-height: 1.5em;
    margin-top: 2px;
    font-size: 14px;
    font-weight: 500;
    color: var(--royal);
  }

  .form-status.is-error {
    color: var(--danger);
  }

  .form-fallback {
    display: none;
    justify-self: start;
    font-size: 14px;
    font-weight: 600;
    color: var(--royal-bright);
    text-decoration: underline;
    text-underline-offset: 0.24em;
  }

  .form-fallback.is-shown {
    display: inline-block;
  }

  @media (width >= 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(56px, 6vw, 112px);
    }
  }
</style>
