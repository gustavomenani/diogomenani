---
/**
 * Cabeçalho das páginas secundárias (aviso de privacidade e 404): a marca e a volta ao site. O
 * Header da home depende das seções, do menu e do script da página, que aqui não existem.
 */
import Logo from './Logo.astro';
---

<header class="simple-header is-royal">
  <div class="wrap simple-header-inner">
    <a class="brand" href="/">
      <Logo
        class="brand-logo"
        tone="white"
        alt="Diogo Menani — Advocacia e Assessoria Jurídica"
        compact
      />
    </a>
    <a class="link-light" href="/">
      Voltar ao site
    </a>
  </div>
</header>

<style>
  .simple-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    min-height: var(--header-h);

    /* Se a volta ao site descer para a linha de baixo, nenhuma das duas cola na borda. */
    padding-block: 12px;
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  /*
   * A mesma altura do logo no header da home (lá ele diminui entre 1080 e 1279 px, por dividir a
   * linha com a navegação, que aqui não existe).
   */
  .brand-logo {
    display: block;
    width: auto;
    height: 52px;
  }

  /*
   * No celular, como no header da home: o logo vai até 240 px de largura e encolhe com a tela,
   * sem empurrar a volta ao site para a linha de baixo (numa linha a partir de 320 px). O link não
   * encolhe nem quebra.
   */
  @media (width <= 479px) {
    .simple-header-inner {
      flex-wrap: nowrap;
      column-gap: 16px;
    }

    .brand {
      flex: 0 1 240px;
      min-width: 0;
    }

    .brand-logo {
      width: 100%;
      height: auto;
    }

    .link-light {
      flex: none;
      white-space: nowrap;
    }
  }

  .link-light {
    font-size: var(--fs-md);
  }

  /* Como o header da home: no papel, a marca e a volta ao site não têm serventia. */
  @media print {
    .simple-header {
      display: none !important;
    }
  }
</style>
