---
import ExternalLink from './ExternalLink.astro';
import Field from './Field.astro';
import Icon from './Icon.astro';
import { areas } from '../data/content';
import { privacyPath } from '../data/site';
import { NEW_TAB_NOTE } from '../lib/links';
import { messages, waLink } from '../lib/whatsapp';
---

{/*
  O formulário depende de JavaScript por design: o script valida e monta a mensagem.
  Obrigatórios com aria-required, não required: o required liga a validação nativa, e o
  leitor de tela anunciaria o campo como inválido antes de qualquer envio.
  method="dialog", e não post: fora de um <dialog>, o envio nativo não sai do navegador. Se o
  módulo da página ainda não chegou, não carregou ou o script do formulário falhou, nome,
  telefone e relato não vão para o servidor (como promete o aviso de privacidade) e o texto
  fica nos campos. O evento submit continua chegando ao script.
*/}
<form class="contact-form" method="dialog" data-contact-form data-reveal novalidate>
  <h3 class="form-title">Prefere escrever?</h3>
  <p class="form-sub">Preencha os campos e a mensagem chega pronta no WhatsApp.</p>
  <div class="fields">
    <Field id="f-nome" label="Nome" error="Informe seu nome.">
      <input
        id="f-nome"
        name="nome"
        type="text"
        autocomplete="name"
        placeholder="Como podemos chamar você?"
        aria-required="true"
      />
    </Field>
    <div class="field-row">
      <Field id="f-tel" label="WhatsApp" error="Informe um número com DDD.">
        <input
          id="f-tel"
          name="telefone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="(00) 00000-0000"
          aria-required="true"
        />
      </Field>
      <Field id="f-email" label="E-mail" optional error="Confira o e-mail digitado.">
        <input
          id="f-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="voce@email.com"
        />
      </Field>
    </div>
    <Field id="f-assunto" label="Assunto" optional>
      <div class="select">
        <select id="f-assunto" name="assunto">
          <option value="">Escolha uma área</option>
          {areas.map((area) => (
            <option value={area.name}>{area.name}</option>
          ))}
          <option value="Outro assunto">Outro assunto</option>
        </select>
        <Icon name="chevron-down" />
      </div>
    </Field>
    <Field id="f-msg" label="Mensagem" error="Escreva uma mensagem curta sobre o seu caso.">
      {/*
        O limite deixa curto o link do wa.me, que leva o texto codificado, e a mensagem legível na
        conversa. O navegador corta em silêncio o texto colado além dele: o script avisa no status.
      */}
      <textarea
        id="f-msg"
        name="mensagem"
        rows="4"
        maxlength="1200"
        placeholder="Conte em poucas linhas o que está acontecendo."
        aria-required="true"
      ></textarea>
    </Field>
    {/* Contêiner próprio (não .field): .field label/input pegariam o checkbox. */}
    <div class="check-field" data-field>
      <label class="check">
        <input class="check-input" id="f-lgpd" type="checkbox" name="lgpd" aria-required="true" />
        <span class="check-box" aria-hidden="true">
          <Icon name="check" strokeWidth={2.6} />
        </span>
        {/*
          O aviso abre em outra aba, para não perder o que foi digitado. Clicar no link não marca
          o checkbox: num <label>, o clique num conteúdo interativo fica com ele.
        */}
        <span>
          Concordo com o uso dos meus dados apenas para o retorno deste contato, conforme a LGPD e o{' '}
          <ExternalLink class="link" href={privacyPath}>
            aviso de privacidade
          </ExternalLink>
          .
        </span>
      </label>
      <p class="field-error" id="f-lgpd-erro" data-field-error>
        Para continuar, confirme o uso dos dados.
      </p>
    </div>
    {/*
      O envio abre o WhatsApp em outra aba (window.open): o leitor de tela ouve o mesmo aviso dos
      links que abrem outra aba (ExternalLink.astro).
    */}
    <button class="btn btn-royal btn-block" type="submit">
      <Icon name="whatsapp" />
      <span class="btn-label">Enviar pelo WhatsApp</span>
      <span class="sr-only">{` ${NEW_TAB_NOTE}`}</span>
    </button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    {/* O envio troca o destino pela mensagem montada; sem ela, vale a mensagem padrão. */}
    <ExternalLink class="link form-fallback" href={waLink(messages.default)} data-form-fallback>
      Se o WhatsApp não abriu, use este link para enviar a mensagem.
    </ExternalLink>
  </div>
</form>

<style>
  .contact-form {
    position: relative;
    padding: clamp(28px, 3vw, 44px);
    border-radius: 28px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 48px 90px -44px var(--shadow-card);
  }

  .form-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 0.8vw + 20px, 32px);
    line-height: 1.15;
    color: var(--royal);
  }

  /* pretty: sem "WhatsApp." sozinho na última linha (a 1024 e a 1080 px), como na .lede. */
  .form-sub {
    margin-top: 8px;
    font-size: var(--fs-md);
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .fields {
    display: grid;
    gap: 18px;
    margin-top: 28px;
  }

  .form-status {
    min-height: 1.5em;
    margin-top: 2px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--royal);
  }

  /*
   * Vazio, o status sai do fluxo da grade: a reserva dele somava o gap da .fields e deixava o pé do
   * cartão com quase o dobro do respiro do topo. Absoluto, e não display: none, ele continua na
   * árvore de acessibilidade, e o aria-live segue anunciando. O aviso só chega depois de um envio
   * ou de digitar, então o cartão crescer não conta como CLS (o link de reserva já faz o mesmo no
   * envio certo).
   */
  .form-status:empty {
    position: absolute;
    margin: 0;
  }

  .form-status.is-error {
    color: var(--danger);
  }

  /* A cor, o sublinhado e o hover vêm do .link (buttons.css), como nos outros links de texto. */
  .form-fallback {
    display: none;
    justify-self: start;
    font-size: var(--fs-sm);
  }

  .form-fallback.is-shown {
    display: inline-block;
  }

  /*
   * Abaixo de 360 px, menos respiro dos lados: o botão de envio cabe numa linha (buttons.css), e o
   * placeholder do Nome, inteiro no campo, com o respiro menor dos campos (forms.css).
   */
  @media (width <= 359px) {
    .contact-form {
      padding-inline: 16px;
    }
  }
</style>
