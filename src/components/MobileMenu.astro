---
import WhatsAppButton from './WhatsAppButton.astro';
import { contact } from '../data/contact';
import { anchor, nav } from '../data/navigation';
---

<nav class="menu" id="menu" aria-label="Menu" data-menu inert>
  <div class="wrap menu-inner">
    <div class="menu-nav">
      {nav.map((item, i) => (
        <a href={anchor(item.id)} style={`--i:${i}`}>
          {item.label}
        </a>
      ))}
    </div>
    <div class="menu-foot">
      <WhatsAppButton label="Fale com um especialista" cta />
      {/*
        Dois blocos em linha: a frase quebra primeiro no "·" (a 320 px, "online" ficava sozinho), e
        cada metade ainda quebra por dentro com o texto ampliado, o que um nowrap impediria.
      */}
      <p>
        <span class="menu-meta">{contact.oab}</span>{' '}
        <span class="menu-meta">· {contact.serviceMode}</span>
      </p>
    </div>
  </div>
</nav>

<style>
  /* Menu mobile: tela cheia, revelado de cima para baixo. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + 28px) 0 32px;
    overflow-y: auto;

    /*
     * Em tela baixa o menu rola por baixo do header fixo, opaco quando aberto: sem a folga, o link
     * focado pelo teclado pararia sob ele (WCAG 2.4.11).
     */
    scroll-padding-top: var(--header-h);
    overscroll-behavior: contain;
    scrollbar-color: var(--sky-dim) transparent;
    scrollbar-width: thin;
    background: var(--royal);
    color: #fff;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.8s var(--ease),
      visibility 0s linear 0.8s;
  }

  :global(.page.is-menu-open) .menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.8s var(--ease),
      visibility 0s;
  }

  /*
   * Em tela baixa o menu rola, e o Firefox foca a área rolável pelo Tab: contorno branco e por
   * dentro, porque o menu ocupa a tela toda.
   */
  :global(.page) .menu:focus-visible {
    outline-color: #fff;
    outline-offset: -5px;
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
  }

  .menu-nav a {
    display: block;
    padding: 8px 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 9vw, 54px);
    line-height: 1.15;
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    transition:
      opacity 0.5s ease,
      transform 0.8s var(--ease);
  }

  /* Ao abrir, os links entram um a um (--i é o índice de cada link). */
  :global(.page.is-menu-open) .menu-nav a {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.16s + var(--i) * 0.06s);
  }

  /*
   * Retorno ao ponteiro, como nos links do rodapé: o menu vale até 1079 px, também em notebook
   * estreito e tablet com mouse. Sublinhado, e não cor com transição, que herdaria o
   * transition-delay escalonado da entrada. O afastamento em em acompanha a serifa grande.
   */
  @media (hover: hover) {
    .menu-nav a:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
  }

  .menu-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin-top: auto;
    padding-top: 32px;
    border-top: 1px solid var(--line-on-royal);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  :global(.page.is-menu-open) .menu-foot {
    opacity: 1;
    transition-delay: 0.45s;
  }

  .menu-foot p {
    font-size: var(--fs-sm);
    color: var(--sky);
  }

  .menu-meta {
    display: inline-block;
  }

  /* Telas baixas (celular deitado): depois das regras base, para valer de fato. */
  @media (height <= 560px) {
    .menu {
      padding-top: var(--header-h);
    }

    .menu-nav a {
      font-size: var(--fs-menu-compact);
      padding: 4px 0;
    }

    .menu-foot {
      padding-top: 20px;
    }
  }

  /* Acima do DESKTOP_QUERY (src/scripts/menu.ts), o menu mobile não existe. */
  @media (width >= 1080px) {
    .menu {
      display: none;
    }
  }

  /*
   * Com movimento reduzido, o menu esmaece em vez de descer como cortina pela tela inteira, como o
   * header e o botão flutuante. Links e rodapé (com a chamada do WhatsApp) entram junto com ele,
   * sem deslize nem escalonamento; o !important vence as regras do menu aberto, mais específicas.
   */
  @media (prefers-reduced-motion: reduce) {
    .menu {
      clip-path: none;
      opacity: 0;
      transition:
        opacity 0.2s ease,
        visibility 0s linear 0.2s;
    }

    :global(.page.is-menu-open) .menu {
      clip-path: none;
      opacity: 1;
      transition:
        opacity 0.2s ease,
        visibility 0s;
    }

    .menu-nav a,
    .menu-foot {
      transform: none !important;
      transition-duration: 0.2s !important;
      transition-delay: 0s !important;
    }
  }

  @media print {
    .menu {
      display: none !important;
    }
  }
</style>
