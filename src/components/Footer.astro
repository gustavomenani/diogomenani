---
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import WhatsAppFab from './WhatsAppFab.astro';
import { THEMIS_SHAPE_ID, themis, wordmark } from '../data/brand';
import { contact, social, whatsapp } from '../data/contact';
import { anchor, footerNav, sectionIds } from '../data/navigation';
import { privacyPath } from '../data/site';
import { waLink } from '../lib/whatsapp';

const year = new Date().getFullYear();

/** Largura e altura de cada linha da assinatura, lidas do viewBox (proporção da imagem). */
const sizeOf = (viewBox: string) => {
  const [width = 0, height = 0] = viewBox.split(' ').slice(2).map(Number);
  return { width, height };
};
const NAME_SIZE = sizeOf(wordmark.name.viewBox);
const SUB_SIZE = sizeOf(wordmark.sub.viewBox);
/** O endereço do site (o `site` do astro.config.mjs), mostrado sem o https:// nem a barra. */
const siteHome = Astro.site && new URL('/', Astro.site);
---

<footer class="footer" data-footer>
  <div class="wrap">
    <div class="footer-brand">
      <svg class="footer-themis" viewBox={themis.viewBox} aria-hidden="true" focusable="false">
        <use href={`#${THEMIS_SHAPE_ID}`}></use>
      </svg>
      {/* O header mostra o logo em arquivo: é aqui que o desenho do monograma entra na página. */}
      <Monogram class="footer-mark" data-reveal />
      <span class="footer-rule" aria-hidden="true" data-reveal="draw"></span>
      {/* A assinatura vem de arquivo (src/pages/wordmark-[part].svg.ts): fica fora do HTML. */}
      <img
        class="footer-name"
        src="/wordmark-name.svg"
        alt="Diogo Menani"
        width={NAME_SIZE.width}
        height={NAME_SIZE.height}
        loading="lazy"
        decoding="async"
      />
      <img
        class="footer-sub"
        src="/wordmark-sub.svg"
        alt="Advocacia e Assessoria Jurídica"
        width={SUB_SIZE.width}
        height={SUB_SIZE.height}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="footer-cols">
      <nav class="footer-col" aria-labelledby="footer-nav-title">
        <p class="footer-col-title" id="footer-nav-title">
          Navegação
        </p>
        {/* role="list" nas listas: sem ele, o VoiceOver ignora listas com list-style: none. */}
        <ul role="list">
          {footerNav.map((link) => (
            <li>
              <a href={anchor(link.id)}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="footer-col">
        <p class="footer-col-title">Contato</p>
        <ul role="list">
          <li>
            <ExternalLink href={waLink()}>WhatsApp {whatsapp.display}</ExternalLink>
          </li>
          <li>
            <a href={contact.email.href}>{contact.email.label}</a>
          </li>
          {siteHome && (
            <li>
              <a href={siteHome.href}>{siteHome.host}</a>
            </li>
          )}
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Redes</p>
        <ul role="list">
          {social.map((item) => (
            <li>
              <ExternalLink href={item.href} aria-label={item.ariaLabel}>
                <Icon name={item.icon} />
                {item.label}
              </ExternalLink>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {year} Diogo Menani. {contact.oab}.
      </p>
      {/* Espaço inseparável depois do "nº": sem ele, o "nº" ficava no fim da linha. */}
      <p class="footer-legal">
        Conteúdo de caráter informativo, em conformidade com o Código de Ética e Disciplina da OAB e
        o Provimento nº&nbsp;205/2021 do CFOAB.
      </p>
      <div class="footer-links">
        <a class="footer-link" href={privacyPath}>
          Privacidade
        </a>
        <a class="footer-link to-top" href={anchor(sectionIds.top)}>
          Voltar ao topo <Icon name="arrow-up" />
        </a>
      </div>
    </div>
  </div>
  {/* Fixo na tela, mas dentro do rodapé: fica num landmark, como o resto do conteúdo. */}
  <WhatsAppFab />
</footer>

<style>
  .footer {
    position: relative;
    padding: clamp(80px, 7vw, 112px) 0 40px;
    background: var(--royal-deep);
    color: #fff;
  }

  .footer-brand {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Têmis do hero reaproveitada (via <use>) como marca d'água atrás da assinatura. */
  .footer-themis {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: -64px;
    height: calc(100% + 120px);
    width: auto;
    aspect-ratio: 860 / 1112;
    transform: translateX(-50%);
    opacity: 0.08;
    pointer-events: none;
  }

  .footer-mark {
    width: clamp(104px, 9vw, 136px);
    height: auto;
  }

  .footer-rule {
    display: block;
    width: min(620px, 86%);
    height: 5px;
    margin: 26px 0 22px;
    border-radius: 5px;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0%) 0%,
      rgb(255 255 255 / 50%) 22%,
      #fff 46%,
      #fff 86%,
      rgb(255 255 255 / 0%) 100%
    );
    filter: drop-shadow(0 0 7px var(--rule-glow));
    transform-origin: center;
  }

  .footer-name {
    width: min(560px, 84%);
    height: auto;
  }

  .footer-sub {
    width: min(470px, 70%);
    height: auto;
    margin-top: 14px;
  }

  .footer-cols {
    display: grid;
    gap: 40px;
    margin-top: 72px;
    padding-top: 48px;
    border-top: 1px solid var(--line-on-royal);
  }

  .footer-col .footer-col-title {
    margin-bottom: 16px;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--sky-dim);
  }

  .footer-col ul {
    display: grid;
    gap: 10px;
  }

  /* Um e-mail longo quebra em qualquer ponto em vez de sair da tela. */
  .footer-col li,
  .footer-col p {
    font-size: var(--fs-md);
    line-height: 1.5;
    color: #fff;
    overflow-wrap: anywhere;
  }

  /*
   * Fora da linha de base: com o ícone na frente, o inline-flex alinharia pela borda de baixo do
   * SVG, e as linhas de Redes ficariam 4 px mais altas que as das colunas ao lado.
   */
  .footer-col a {
    display: inline-flex;
    vertical-align: top;
    align-items: center;
    gap: 10px;
    opacity: 0.88;
    transition: opacity 0.3s;
  }

  @media (hover: hover) {
    .footer-col a:hover {
      opacity: 1;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.28em;
    }
  }

  .footer-col :global(svg) {
    width: 18px;
    height: 18px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line-on-royal);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--sky);
  }

  /* O aviso legal cede largura: no desktop, cabe na mesma linha do copyright e dos links. */
  .footer-legal {
    flex: 1 1 24em;
    max-width: 50em;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 32px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #fff;
    font-weight: 600;
  }

  @media (hover: hover) {
    .footer-link:not(.to-top):hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.28em;
    }
  }

  .to-top :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.6s var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .to-top:hover :global(svg) {
      transform: translateY(-3px);
    }
  }

  @media (width >= 768px) {
    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* No papel, o fundo royal escuro sai junto: o texto é branco. */
  @media print {
    .footer {
      /* stylelint-disable-next-line property-no-vendor-prefix -- o Chrome antes do 136 só lê com prefixo */
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
