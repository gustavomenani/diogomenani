---
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import { THEMIS_SHAPE_ID, wordmark } from '../data/brand';
import { contact, social, whatsapp } from '../data/contact';
import { anchor, footerNav, sectionIds } from '../data/navigation';
import { externalLink } from '../lib/links';
import { waLink } from '../lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="footer" data-footer>
  <div class="wrap">
    <div class="footer-brand">
      <svg class="footer-themis" viewBox="0 0 860 1112" aria-hidden="true" focusable="false">
        <use href={`#${THEMIS_SHAPE_ID}`}></use>
      </svg>
      <Monogram class="footer-mark" data-reveal />
      <span class="footer-rule" aria-hidden="true" data-reveal="draw"></span>
      <svg
        class="footer-name"
        viewBox={wordmark.name.viewBox}
        role="img"
        aria-label="Diogo Menani"
        focusable="false"
      >
        <path fill="currentColor" d={wordmark.name.d}></path>
      </svg>
      <svg
        class="footer-sub"
        viewBox={wordmark.sub.viewBox}
        role="img"
        aria-label="Advocacia e Assessoria Jurídica"
        focusable="false"
      >
        <path fill="currentColor" d={wordmark.sub.d}></path>
      </svg>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <p class="footer-col-title">Navegação</p>
        <ul>
          {footerNav.map((link) => (
            <li>
              <a href={anchor(link.id)}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Contato</p>
        <ul>
          <li>
            <a href={waLink()} {...externalLink()}>
              WhatsApp {whatsapp.display}
            </a>
          </li>
          <li>
            <a href={contact.email.href}>{contact.email.label}</a>
          </li>
          <li>{contact.address}</li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Redes</p>
        <ul>
          {social.map((item) => (
            <li>
              <a href={item.href} {...externalLink()} aria-label={item.ariaLabel}>
                <Icon name={item.icon} />
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {year} Diogo Menani. {contact.oab}.
      </p>
      <p class="footer-legal">
        Conteúdo de caráter informativo, em conformidade com o Código de Ética e Disciplina da OAB e
        o Provimento nº 205/2021 do CFOAB.
      </p>
      <a class="to-top" href={anchor(sectionIds.top)}>
        Voltar ao topo <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: clamp(80px, 7vw, 112px) 0 40px;
    background: var(--royal-deep);
    color: #fff;
  }

  .footer-brand {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Têmis do hero reaproveitada (via <use>) como marca d'água atrás da assinatura. */
  .footer-themis {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: -64px;
    height: calc(100% + 120px);
    width: auto;
    aspect-ratio: 860 / 1112;
    transform: translateX(-50%);
    opacity: 0.08;
    pointer-events: none;
  }

  .footer-mark {
    width: clamp(104px, 9vw, 136px);
    height: auto;
  }

  .footer-rule {
    display: block;
    width: min(620px, 86%);
    height: 5px;
    margin: 26px 0 22px;
    border-radius: 5px;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0%) 0%,
      rgb(255 255 255 / 50%) 22%,
      #fff 46%,
      #fff 86%,
      rgb(255 255 255 / 0%) 100%
    );
    filter: drop-shadow(0 0 7px rgb(160 182 255 / 70%));
    transform-origin: center;
  }

  .footer-name {
    width: min(560px, 84%);
    height: auto;
    color: #fff;
  }

  .footer-sub {
    width: min(470px, 70%);
    height: auto;
    margin-top: 14px;
    color: #fff;
  }

  .footer-cols {
    display: grid;
    gap: 40px;
    margin-top: 72px;
    padding-top: 48px;
    border-top: 1px solid var(--line-royal);
  }

  .footer-col .footer-col-title {
    margin-bottom: 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--sky-dim);
  }

  .footer-col ul {
    display: grid;
    gap: 10px;
  }

  .footer-col li,
  .footer-col p {
    font-size: 15.5px;
    line-height: 1.5;
    color: #fff;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    opacity: 0.88;
    transition: opacity 0.3s;
  }

  .footer-col a:hover {
    opacity: 1;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .footer-col :global(svg) {
    width: 18px;
    height: 18px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line-royal);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--sky);
  }

  .footer-legal {
    max-width: 50em;
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #fff;
    font-weight: 600;
  }

  .to-top :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.6s var(--ease);
  }

  .to-top:hover :global(svg) {
    transform: translateY(-3px);
  }

  @media (width >= 768px) {
    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
