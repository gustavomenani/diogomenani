---
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import SimpleFooter from '../components/SimpleFooter.astro';
import SimpleHeader from '../components/SimpleHeader.astro';
import { contact, whatsapp } from '../data/contact';
import { sectionIds } from '../data/navigation';
import { privacySections, privacyUpdated } from '../data/privacy';
import { privacyPath, site } from '../data/site';
import { waLink } from '../lib/whatsapp';

const SUMMARY = 'Como o site de Diogo Menani trata os dados de quem entra em contato.';

/**
 * Os links do aviso: onde a frase aparece no texto, ela vira link. Os que levam para fora do site
 * abrem em outra aba; o e-mail abre o programa de e-mail.
 */
const LINKS = [
  { text: whatsapp.display, href: waLink(), external: true },
  { text: contact.email.label, href: contact.email.href, external: false },
  {
    text: 'política de privacidade do WhatsApp',
    href: 'https://www.whatsapp.com/legal/privacy-policy',
    external: true,
  },
  {
    text: 'Autoridade Nacional de Proteção de Dados (ANPD)',
    href: 'https://www.gov.br/anpd',
    external: true,
  },
] as const;

/** Termo que não quebra no hífen: "e-" no fim de uma linha e "mail" no começo da outra. */
const NOWRAP = 'e-mail';

// Um link cuja frase saiu do texto sumiria em silêncio: o build para.
const fullText = privacySections.flatMap((section) => section.paragraphs.flat()).join('\n');
for (const link of LINKS) {
  if (!fullText.includes(link.text)) {
    throw new Error(`Aviso de privacidade: a frase do link "${link.text}" não está no texto.`);
  }
}

const escapeRegExp = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
/** As frases dos links e o termo sem quebra; o grupo faz o split devolver o que achou. */
const TERMS = new RegExp(
  `(${[...LINKS.map(({ text }) => text), NOWRAP].map(escapeRegExp).join('|')})`,
);

/** O texto em pedaços: texto corrido, links e o termo sem quebra. */
function pieces(text: string) {
  return text
    .split(TERMS)
    .filter(Boolean)
    .map((piece) => ({
      text: piece,
      link: LINKS.find((item) => item.text === piece),
      nowrap: piece === NOWRAP,
    }));
}
---

<Base
  title={`Aviso de privacidade — ${site.shortName}`}
  description={SUMMARY}
  path={privacyPath}
  interactive={false}
>
  <SimpleHeader />
  <main id={sectionIds.main} class="privacy">
    <div class="wrap privacy-inner">
      <h1 class="h2">Aviso de privacidade</h1>
      <p class="lede privacy-lede">
        {SUMMARY} Atualizado em {privacyUpdated}.
      </p>
      {privacySections.map((section) => (
        <section class="privacy-section">
          <h2>{section.title}</h2>
          {section.paragraphs.map((block) => {
            const rich = (text: string) =>
              pieces(text).map(({ text: piece, link, nowrap }) => {
                if (link?.external) {
                  return (
                    <ExternalLink class="link" href={link.href}>
                      {piece}
                    </ExternalLink>
                  );
                }
                if (link) {
                  return (
                    <a class="link" href={link.href}>
                      {piece}
                    </a>
                  );
                }
                return nowrap ? <span class="nowrap">{piece}</span> : piece;
              });
            if (typeof block !== 'string') {
              return (
                <ul>
                  {block.map((item) => (
                    <li>{rich(item)}</li>
                  ))}
                </ul>
              );
            }
            return <p>{rich(block)}</p>;
          })}
        </section>
      ))}
    </div>
  </main>
  <SimpleFooter />
</Base>

<style>
  .privacy {
    padding-block: clamp(56px, 4vw + 32px, 104px);
  }

  .privacy-inner {
    max-width: calc(46rem + 2 * var(--gutter));
  }

  .privacy-lede {
    margin-top: 20px;
  }

  .privacy-section {
    margin-top: clamp(36px, 2vw + 24px, 52px);
  }

  .privacy-section h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 0.6vw + 20px, 30px);
    line-height: 1.2;
    color: var(--royal);
  }

  .privacy-section p,
  .privacy-section ul {
    margin-top: 14px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* A base.css tira os marcadores das listas; esta, de texto corrido, volta a tê-los. */
  .privacy-section ul {
    padding-left: 1.25em;
    list-style: disc;
  }

  .privacy-section li + li {
    margin-top: 6px;
  }

  .privacy-section li::marker {
    color: var(--royal-bright);
  }

  .nowrap {
    white-space: nowrap;
  }
</style>
