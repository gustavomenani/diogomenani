---
import Base from '../layouts/Base.astro';
import Areas from '../components/Areas.astro';
import Contato from '../components/Contato.astro';
import Duvidas from '../components/Duvidas.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Processo from '../components/Processo.astro';
import Sobre from '../components/Sobre.astro';
import { sectionIds } from '../data/navigation';
import { site } from '../data/site';
import { structuredData } from '../lib/structured-data';

/** Cor da barra do navegador: o azul-noite do alto do hero (--navy em tokens.css). */
const HERO_TOP = '#020A34';
---

<Base
  title={site.title}
  description={site.description}
  path="/"
  structuredData={structuredData(Astro.site)}
  themeColor={HERO_TOP}
>
  <Header />
  <main id={sectionIds.main}>
    <Hero />
    <Sobre />
    <Areas />
    <Processo />
    <Manifesto />
    <Duvidas />
    <Contato />
  </main>
  <Footer />
</Base>
