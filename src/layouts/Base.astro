---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { anchor, sectionIds } from '../data/navigation';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Caminho da página no site ('/', '/privacidade'): canonical e og:url. */
  path: string;
  /** Tira a página dos buscadores (a 404). */
  noindex?: boolean;
  /** JSON-LD da página. */
  structuredData?: object;
}

const { title, description, path, noindex = false, structuredData } = Astro.props;

// Canonical, og:url e a imagem de prévia exigem endereço absoluto: sem o `site` do
// astro.config.mjs, essas tags não saem (quem lê o Open Graph não resolve caminho relativo).
const canonical = Astro.site && new URL(path, Astro.site).href;
const ogImage = Astro.site && new URL(site.ogImage, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Prévia do link no WhatsApp e nas redes. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <Fragment>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={site.ogImageAlt} />
        <meta name="twitter:image" content={ogImage} />
      </Fragment>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#00167B" />
    {/*
      PNG para os navegadores que não usam o favicon SVG; a tela de início do iOS pede o próprio
      ícone, quadrado e opaco (o sistema arredonda os cantos). Gerados por npm run generate:images.
    */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Só as variantes normais têm preload: a itálica aparece apenas na seção Sobre. */}
    <Font cssVariable="--font-baskervville" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-hanken" preload={[{ style: 'normal' }]} />
    {/*
      Sem script: o header rola com a página (fixo, ficaria branco sobre as seções brancas), e o
      botão Menu e o formulário, que dependem de script, não aparecem.
    */}
    <noscript>
      <style>
        .page .site-header {
          position: absolute;
        }

        .page .menu-toggle,
        .page .contact-form {
          display: none;
        }
      </style>
    </noscript>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <div class="page" data-page data-motion="pending">
      {/*
        Decide o modo de movimento antes da primeira pintura (motion-mode.ts). Se o módulo da
        página não rodar (rede, erro), devolve no load o modo sem script, em que tudo aparece.
      */}
      <script is:inline>
        (() => {
          const root = document.currentScript.parentElement;
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.dataset.motion = reduce ? 'reduced' : 'on';
          addEventListener('load', () => {
            if ('ready' in root.dataset) return;
            root.setAttribute('data-instant', '');
            root.dataset.motion = 'pending';
            root.getBoundingClientRect();
            requestAnimationFrame(() => root.removeAttribute('data-instant'));
          });
        })();
      </script>
      <a class="skip-link" href={anchor(sectionIds.main)}>
        Pular para o conteúdo
      </a>
      <slot />
    </div>
    <script>
      import { initPage } from '../scripts/main';

      const root = document.querySelector<HTMLElement>('[data-page]');
      if (root) initPage(root);
    </script>
  </body>
</html>
