---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { anchor, sectionIds } from '../data/navigation';
import { site } from '../data/site';
import { pageUrls } from '../lib/page-meta';
import { serializeJsonLd } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  /** Caminho da página no site ('/', '/privacidade/'): canonical e og:url. */
  path: string;
  /** Tira a página dos buscadores (a 404). */
  noindex?: boolean;
  /** JSON-LD da página. */
  structuredData?: object;
  /**
   * Liga o movimento e o módulo da página (padrão). As páginas secundárias (aviso de privacidade
   * e 404) passam `false`: sem o script do movimento e sem o módulo, a raiz fica em `pending`, em
   * que tudo aparece. O aviso tem só o script da volta ao site, no privacidade.astro.
   */
  interactive?: boolean;
  /**
   * Cor da barra do navegador no celular, a do topo da página para as duas emendarem: royal por
   * padrão (aviso de privacidade e 404, de cabeçalho royal); a home passa o azul-noite do hero.
   */
  themeColor?: string;
}

const {
  title,
  description,
  path,
  noindex = false,
  structuredData,
  interactive = true,
  themeColor = '#00167B',
} = Astro.props;

// Sem o `site` do astro.config.mjs (ou com noindex, no caso do canonical), essas tags não saem.
const { canonical, ogImage } = pageUrls(path, Astro.site, noindex);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Prévia do link no WhatsApp e nas redes. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <Fragment>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={site.ogImageAlt} />
        <meta name="twitter:image" content={ogImage} />
        {/* O X não usa o og:image:alt como alternativa: a descrição da imagem vai repetida. */}
        <meta name="twitter:image:alt" content={site.ogImageAlt} />
      </Fragment>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={themeColor} />
    {/*
      Só há tema claro. O "only" impede que o escurecimento forçado do Android (Chrome com
      "Escurecer sites", Samsung Internet no tema escuro, WebViews de apps) recolora a página: o
      logo é <img> e não é recolorido, e o texto preto e o monograma azul dele sumiriam no fundo
      quase preto. Não muda o alto contraste (forced-colors), que segue o sistema.
    */}
    <meta name="color-scheme" content="only light" />
    {/*
      PNG para os navegadores que não usam o favicon SVG, e o de 96 px para o Google Search, que
      não aceita SVG e pede ícones de mais de 48 px; a tela de início do iOS pede o próprio ícone,
      quadrado e opaco (o sistema arredonda os cantos). O /favicon.ico, que navegadores e robôs
      pedem direto, não precisa de <link>. Gerados por npm run generate:images.
    */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Só há variantes normais; o filtro garante que uma itálica, se voltar, não entre no preload. */}
    <Font cssVariable="--font-baskervville" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-hanken" preload={[{ style: 'normal' }]} />
    {/*
      Sem script: o header rola com a página (fixo, ficaria branco sobre as seções brancas), e o
      botão Menu, que depende de script, não aparece. Com script, mas sem o módulo da página, vale
      o mesmo pelo data-fallback (base.css).
    */}
    <noscript>
      <style>
        .page .site-header {
          position: absolute;
        }

        .page .menu-toggle {
          display: none;
        }
      </style>
    </noscript>
    {structuredData && (
      <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    )}
  </head>
  <body>
    <div class="page" data-page data-motion="pending">
      {/*
        Decide o modo de movimento antes da primeira pintura (motion-mode.ts). Se o módulo da
        página não rodar (rede, erro), devolve no load o modo sem script, em que tudo aparece, e
        marca data-fallback: o header rola com a página e o Menu some (base.css).
        Mexer neste script exige trocar o hash dele na CSP (vercel.json e public/_headers).
      */}
      {interactive && <script is:inline>
        (() => {
          const root = document.currentScript.parentElement;
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.dataset.motion = reduce ? 'reduced' : 'on';
          addEventListener('load', () => {
            if ('ready' in root.dataset) return;
            root.dataset.fallback = '';
            root.setAttribute('data-instant', '');
            root.dataset.motion = 'pending';
            root.getBoundingClientRect();
            requestAnimationFrame(() => root.removeAttribute('data-instant'));
          });
        })();
      </script>}
      <a class="skip-link" href={anchor(sectionIds.main)}>
        Pular para o conteúdo
      </a>
      <slot />
    </div>
    {interactive && <script>
      import { initPage } from '../scripts/main';

      const root = document.querySelector<HTMLElement>('[data-page]');
      if (root) initPage(root);
    </script>}
  </body>
</html>
