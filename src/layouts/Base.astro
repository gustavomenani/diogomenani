---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { anchor, sectionIds } from '../data/navigation';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00167B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Só as variantes normais têm preload: a itálica aparece apenas na seção Sobre. */}
    <Font cssVariable="--font-bodoni" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-hanken" preload={[{ style: 'normal' }]} />
  </head>
  <body>
    <div class="page" data-page data-motion="pending">
      <a class="skip-link" href={anchor(sectionIds.main)}>
        Pular para o conteúdo
      </a>
      <slot />
    </div>
    <script>
      import { initPage } from '../scripts/main';

      const root = document.querySelector<HTMLElement>('[data-page]');
      if (root) initPage(root);
    </script>
  </body>
</html>
