# Cabeçalhos da Netlify e da Cloudflare Pages; a Vercel lê os mesmos do vercel.json (um teste
# confere que os dois batem).
#
# Segurança, em todas as respostas. A CSP só deixa rodar o que é do próprio site e os scripts
# inline do Base.astro (o modo de movimento) e do privacidade.astro (a volta ao site), pelo hash:
# mexer num deles exige trocar o hash aqui e no vercel.json (o teste "hash do script inline está
# na CSP" reprova se esquecer). O 'unsafe-inline' fica só no style-src: o CSS embutido muda a cada
# build e os style= são custom properties; quem barra script injetado é o script-src. O
# frame-ancestors (e o X-Frame-Options, para os navegadores antigos) impede embutir a página
# noutra; o form-action 'none' barra o envio nativo do formulário, que só sai pelo WhatsApp. O
# HSTS fica sem includeSubDomains e sem preload até o domínio final existir e todos os
# subdomínios dele terem HTTPS.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-x+YcKpkqFHmPtRKcgfnVo5xfgW5481GdrG+OdPi+Jzw=' 'sha256-smNj+aZa9ZfK6IjlPFnkF/loV7HG3ddb0Q5dB5QMB+k='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Assets com hash no nome: nunca mudam, então o navegador guarda por 1 ano.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo e assinatura têm nome fixo: um dia de cache, e depois o navegador usa a cópia guardada
# enquanto revalida em segundo plano (sem isso, cada visita espera um 304 antes de mostrar a marca).
/logo-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/wordmark-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
