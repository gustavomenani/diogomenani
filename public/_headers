# Cabeçalhos da Netlify e da Cloudflare Pages; a Vercel lê os mesmos do vercel.json (um teste
# confere que os dois batem).
#
# Segurança, em todas as respostas. A CSP só deixa rodar o que é do próprio site e o script
# inline do Base.astro (o modo de movimento), pelo hash: mexer nele exige trocar o hash aqui e no
# vercel.json (o teste "hash do script inline está na CSP" reprova se esquecer). O 'unsafe-inline'
# fica só no style-src: o CSS embutido muda a cada build e os style= são custom properties; quem
# barra script injetado é o script-src. O frame-ancestors (e o X-Frame-Options, para os
# navegadores antigos) impede embutir a página noutra; o form-action 'none' barra qualquer envio
# de formulário (o site não tem nenhum). O HSTS fica sem includeSubDomains e sem preload até o
# domínio final existir e todos os subdomínios dele terem HTTPS.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-x+YcKpkqFHmPtRKcgfnVo5xfgW5481GdrG+OdPi+Jzw='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Assets com hash no nome: nunca mudam, então o navegador guarda por 1 ano.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo e assinatura têm nome fixo: um dia de cache, e depois o navegador usa a cópia guardada
# enquanto revalida em segundo plano (sem isso, cada visita espera um 304 antes de mostrar a marca).
/logo-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/wordmark-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
